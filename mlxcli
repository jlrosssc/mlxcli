def stream_once(url, key, model, messages, agentic_mode, backend, display_content=True):
    """One streamed request. Returns (content, tool_calls, usage, stream_error).

    stream_error is set when the server sends an error payload mid-stream
    (e.g. its structured-output decoder chokes on a tool call the model
    emitted despite no tools being declared for this turn) rather than
    failing the initial HTTP request. Without checking for this, such a
    response looks like an ordinary short/truncated answer.
    """
    settings = load_model_settings(backend)
    payload = {"model": model, "messages": request_messages_for_mode(messages, agentic_mode, backend),
               "max_tokens": settings["max_tokens"], "stream": True,
               "stream_options": {"include_usage": True},
               "temperature": settings["temperature"],
               "top_p": settings["top_p"],
               "top_k": settings["top_k"],
               "repetition_penalty": settings["repetition_penalty"]}
    if agentic_mode:
        payload["tools"] = TOOLS
    content_parts = []
    calls = {}
    usage = {}
    stream_error = None
    printed = False
    repetition_detected = False
    chunks_since_check = 0
    with urllib.request.urlopen(request(url, key, "/v1/chat/completions",
                                        payload), timeout=900) as r:
        for rawline in r:
            line = rawline.decode("utf-8", errors="replace").strip()
            if not line.startswith("data:"):
                continue
            data = line[5:].strip()
            if data == "[DONE]":
                break
            try:
                chunk = json.loads(data)
            except json.JSONDecodeError:
                continue
            if chunk.get("error"):
                stream_error = chunk["error"]
                break
            if chunk.get("usage"):
                usage = chunk["usage"]
            choices = chunk.get("choices") or []
            if not choices:
                continue
            delta = choices[0].get("delta") or {}
            piece = delta.get("content")
            if piece:
                if display_content and not printed:
                    print()
                    printed = True
                if display_content:
                    print(piece, end="", flush=True)
                content_parts.append(piece)
                chunks_since_check += 1
                # Check periodically rather than on every token — cheap enough at
                # this cadence, and stopping within ~15 chunks of a stuck model
                # falling into a repetition loop is what actually matters, not
                # catching it on the exact first repeated character.
                if chunks_since_check >= 15:
                    chunks_since_check = 0
                    if detect_repetition_loop("".join(content_parts)):
                        repetition_detected = True
                        break
            for tc in delta.get("tool_calls") or []:
                idx = tc.get("index", 0)
                slot = calls.setdefault(idx, {"id": tc.get("id"),
                                              "name": "", "arguments": ""})
                if tc.get("id"):
                    slot["id"] = tc["id"]
                fn = tc.get("function") or {}
                if fn.get("name"):
                    slot["name"] += fn["name"]
                if fn.get("arguments"):
                    slot["arguments"] += fn["arguments"]
    if printed:
        print()
    if repetition_detected:
        print("  (model generation fell into a repetition loop; stopped early)")
    tool_calls = [{"id": c["id"] or f"call_{i}", "type": "function",
                   "function": {"name": c["name"], "arguments": c["arguments"]}}
                  for i, c in sorted(calls.items())]
    content = "".join(content_parts)
    if not tool_calls:
        tool_calls = parse_text_tool_calls(content)
        if tool_calls:
            print("(compatibility: parsed textual tool call; structured tool calls are preferred)")
    if not tool_calls:
        tool_calls = parse_bare_json_tool_call(content)
        if tool_calls:
            print("(compatibility: parsed a bare function-name-plus-JSON tool call; structured tool calls are preferred)")
    if not tool_calls:
        tool_calls = parse_xml_tag_tool_call(content)
        if tool_calls:
            print("(compatibility: parsed an XML-tag-style tool call; structured tool calls are preferred)")
    if not tool_calls:
        tool_calls = parse_python_call_tool_call(content)
        if tool_calls:
            print("(compatibility: parsed a Python-call-style tool call; structured tool calls are preferred)")
    # Text-adapter call syntax is protocol data, not assistant prose. Keeping it
    # in the assistant message can make Turbo parse the same call a second time.
    if tool_calls and "call:" in content:
        content = ""
    return content, tool_calls, usage, stream_error, repetition_detected


def chat_turn(url, key, model, messages, totals, agentic_mode, backend, execution_required=False, contract=None):
    # Guard the whole turn (all agentic tool-call retries included, not just
    # one HTTP request) so a long local generation can't get killed by the
    # Mac going to sleep mid-turn.
    with caffeinate_guard():
        return _chat_turn_body(url, key, model, messages, totals, agentic_mode, backend, execution_required, contract)


def offer_smoke_test(written_py_paths):
    """After a turn writes one or more Python files, offer to briefly launch
    whichever of them look like entry points — catches import-time/runtime
    crashes that py_compile can't see (missing deps, bad wiring between
    files). Interactive only: skipped outright if stdin isn't a real
    terminal, so a headless --run never blocks waiting for an answer."""
    if not written_py_paths or not sys.stdin.isatty():
        return
    candidates = find_entry_point_candidates(written_py_paths)
    if not candidates:
        return
    names = ", ".join(p.name for p in candidates)
    try:
        answer = input(f"(run a smoke test on {names} now, to catch startup errors py_compile can't see? [y/N] ").strip().lower()
    except (EOFError, KeyboardInterrupt):
        print()
        return
    if answer not in ("y", "yes"):
        return
    for path in candidates:
        print(f"  smoke-testing {path.name}...")
        ok, message = smoke_test_python_app(path)
        status = "PASS" if ok else "FAIL"
        print(f"  [{status}] {path.name}: {message}")


def _chat_turn_body(url, key, model, messages, totals, agentic_mode, backend, execution_required=False, contract=None):
    turn_start = time.time()
    turn_in = 0
    turn_out = 0
    retried_empty = False
    repetition_streak = 0
    tool_state = {"write": False, "run": False, "verify": False}
    contract = contract or {}
    last_tool_results = []
    written_py_paths = []
    written_paths = []
    review_passes = 0
    written_count_before_review = 0
    MAX_REVIEW_PASSES = 2
    # Captured before any retry/correction messages get injected below, so the
    # review prompt always references the user's actual ask, not one of this
    # loop's own injected follow-ups (which are also role="user").
    original_user_text = next(
        (m.get("content") for m in reversed(messages) if m.get("role") == "user"), "")
    # Everything from here on (this turn's own tool_calls/tool-result
    # messages) is fair game for in-turn compaction; nothing before it is
    # ever touched — that's trim()'s job, between turns.
    turn_start_index = len(messages)
    seen_tool_calls = {}
    effective_agentic_mode = agentic_mode
    retried_with_tools = False
    for _ in range(MAX_TOOL_STEPS):
        content, tool_calls, usage, stream_error, repetition_detected = stream_once(
            url, key, model, messages, effective_agentic_mode, backend,
            display_content=not execution_required,
        )
        if repetition_detected:
            repetition_streak += 1
            if repetition_streak >= 2:
                # It fell into the identical failure mode twice in a row for this
                # request — further retries are very unlikely to help, and each one
                # burns a full generation on garbage. Give up with an honest message
                # instead of exhausting MAX_TOOL_STEPS on repeated dead ends.
                log_error("chat_turn", f"repetition loop stopped twice in a row (backend={backend}, model={model})")
                print("(stopped: the model repeated the same generation-loop failure twice in a row; try rephrasing the request)")
                totals["in"] += turn_in
                totals["out"] += turn_out
                print_tokens("turn", turn_in, turn_out, elapsed=time.time() - turn_start)
                return turn_in, turn_out
        else:
            repetition_streak = 0
        if stream_error:
            # The model attempted a tool call the server couldn't resolve, most often
            # because conversation history primed it to keep calling tools even on a
            # turn where none were declared. Give it a real chance to use one before
            # treating the truncated response as if it were a normal, complete answer.
            if not effective_agentic_mode and not retried_with_tools:
                retried_with_tools = True
                effective_agentic_mode = True
                print("(server rejected an unexpected tool call; retrying with tools enabled)")
                continue
            log_error("chat_turn", f"server error mid-generation (backend={backend}, model={model}): {stream_error}")
            print(f"(server error mid-generation: {stream_error}; response below may be incomplete)")
        in_tokens, out_tokens = usage_counts(usage)
        turn_in += in_tokens
        turn_out += out_tokens
        if in_tokens >= SERVER_MAX_CONTEXT_TOKENS * COMPACT_THRESHOLD_RATIO:
            messages, chars_saved = compact_turn_messages(messages, turn_start_index)
            if chars_saved > 0:
                print(f"(context at {in_tokens:,}/{SERVER_MAX_CONTEXT_TOKENS:,} tokens — "
                      f"compacted {chars_saved:,} chars of older tool results to make room)")
        if not tool_calls:
            if not content and in_tokens == 0 and out_tokens == 0:
                if not retried_empty:
                    retried_empty = True
                    print("(empty model response; retrying once)")
                    continue
                if last_tool_results:
                    print("(model continuation failed; preserving tool results)")
                    for result in last_tool_results:
                        print(result)
                else:
                    msg_chars = sum(len(m.get("content") or "") for m in messages)
                    log_error("chat_turn", f"turn failed: server returned no output and no token usage (backend={backend}, model={model}, agentic={effective_agentic_mode}, execution_required={execution_required}, messages={len(messages)}, msg_chars={msg_chars}, step={_})")
                    print("(turn failed: server returned no output and no token usage; reduce loaded context or retry)")
                return 0, 0
            if execution_required and _ == 0:
                messages.append({"role": "assistant", "content": content})
                messages.append({"role": "user", "content": (
                    "Execution required for this request. You did not call a tool. "
                    "Do not report completion. Use run_command, read_file, or write_file now to perform the requested actions, "
                    "then verify the exact output paths before responding."
                )})
                print("(model returned prose without performing the requested file operation; requesting tool execution)")
                if SHOW_THINKING and content:
                    print(f"  [thinking] {content}")
                continue
            unmet = [name for name, required in contract.items() if required and not tool_state.get(name)]
            if execution_required and unmet:
                if _ < MAX_TOOL_STEPS - 1:
                    messages.append({"role": "assistant", "content": content})
                    messages.append({"role": "user", "content": (
                        "Do not claim completion. Required actions still lack evidence: " + ", ".join(unmet) +
                        ". Use the appropriate tools and verify their results before responding."
                    )})
                    print(f"(verification incomplete: {', '.join(unmet)}; requesting missing tool actions)")
                    if SHOW_THINKING and content:
                        print(f"  [thinking] {content}")
                    continue
                print(f"(unverified: missing tool evidence for {', '.join(unmet)})")
                return turn_in, turn_out
            if execution_required:
                print("(verified tool actions completed)")
                if content:
                    print(content)
            fix_made_last_pass = len(written_paths) > written_count_before_review
            needs_review = written_paths and review_passes < MAX_REVIEW_PASSES and (
                review_passes == 0 or fix_made_last_pass)
            if needs_review:
                review_passes += 1
                written_count_before_review = len(written_paths)
                messages.append({"role": "assistant", "content": content})
                paths_list = ", ".join(written_paths)
                confirming = review_passes > 1
                messages.append({"role": "user", "content": (
                    (f"You just made a change during review. Before finishing: re-read {paths_list} "
                     "in full using read_file to confirm the fix is actually correct and complete, "
                     "not just different. "
                     if confirming else
                     f"Before finishing: re-read {paths_list} in full using read_file, exactly as written, "
                     "not from memory. ") +
                    "Then check two things against the original request "
                    f"({original_user_text[:200]!r}): "
                    "(1) every name you reference — entity ID, variable, import, helper, function — is defined "
                    "with the exact same spelling and domain everywhere it's used; a value read from one name "
                    "and written to a different name is a bug even if both look similar. "
                    "(2) walk through at least 2-3 concrete edge-case inputs relevant to the request and confirm "
                    "the logic produces the correct result for each one, showing the walkthrough. "
                    "If you find a problem, fix it now with write_file and explain what changed. "
                    "If you find nothing wrong, say so briefly — do not rewrite files that are already correct."
                )})
                print("(reviewing written file(s) before finishing...)" if not confirming
                      else "(confirming the fix before finishing...)")
                continue
            offer_smoke_test(written_py_paths)
            messages.append({"role": "assistant", "content": content})
            totals["in"] += turn_in
            totals["out"] += turn_out
            print_tokens("turn", turn_in, turn_out, elapsed=time.time() - turn_start)
            return turn_in, turn_out
        messages.append({"role": "assistant", "content": content or None,
                         "tool_calls": tool_calls})
        if SHOW_THINKING and content:
            print(f"  [thinking] {content}")
        repeated_failure = False
        for call in tool_calls:
            fn = normalize_tool_name(call["function"]["name"])
            call["function"]["name"] = fn
            try:
                args = json.loads(call["function"].get("arguments") or "{}")
            except json.JSONDecodeError:
                args = {}
            call_key = (fn, json.dumps(args, sort_keys=True, ensure_ascii=False))
            # run_command/python_interpreter results depend on external state
            # (the filesystem, running processes) that legitimately changes
            # between identical calls within a turn — e.g. "run the test" after
            # "fix the file" after "run the test" is a real re-verification, not
            # a duplicate. Caching those would replay a stale result and could
            # misreport a since-fixed failure as a repeated one, aborting a turn
            # that actually succeeded. Only cache calls whose result is a
            # function of their arguments alone (read_file, write_file, etc).
            cacheable = fn not in {"run_command", "python_interpreter"}
            if cacheable and call_key in seen_tool_calls:
                result = seen_tool_calls[call_key]
                print("  (duplicate tool call suppressed; reusing prior result)")
                if tool_result_failed(result):
                    repeated_failure = True
            else:
                result = exec_tool(fn, args)
                if cacheable:
                    seen_tool_calls[call_key] = result
            if fn == "write_file" and not tool_result_failed(result):
                tool_state["write"] = True
                written_match = re.match(r"^Written: (.+?) \(", result)
                if written_match:
                    current_user_text = next(
                        (m.get("content") for m in reversed(messages) if m.get("role") == "user"), ""
                    )
                    record_last_artifact(written_match.group(1), current_user_text)
                    written_paths.append(written_match.group(1))
                    if written_match.group(1).endswith(".py"):
                        written_py_paths.append(written_match.group(1))
            if fn in {"run_command", "python_interpreter"} and not tool_result_failed(result):
                tool_state["run"] = True
            if fn == "read_file" or (fn in {"run_command", "python_interpreter"} and "stat " in (args.get("command", "") if isinstance(args, dict) else "")):
                if not tool_result_failed(result):
                    tool_state["verify"] = True
            last_tool_results.append(result)
            messages.append({"role": "tool", "tool_call_id": call["id"],
                             "content": result})
        if repeated_failure:
            log_error("chat_turn", f"stopped: repeated already-failed tool call (backend={backend}, model={model})")
            print("(stopped: the model repeated an already-failed tool call instead of adapting)")
            totals["in"] += turn_in
            totals["out"] += turn_out
            print_tokens("turn", turn_in, turn_out, elapsed=time.time() - turn_start)
            return turn_in, turn_out
    log_error("chat_turn", f"stopped: too many tool steps (backend={backend}, model={model})")
    print("(stopped: too many tool steps — break the task into smaller pieces)")
    totals["in"] += turn_in
    totals["out"] += turn_out
    print_tokens("turn", turn_in, turn_out, elapsed=time.time() - turn_start)
    return turn_in, turn_out


def trim(messages):
    starts = [i for i, m in enumerate(messages) if m.get("role") == "user"]
    if len(starts) > MAX_HISTORY_TURNS:
        cut = starts[-MAX_HISTORY_TURNS]
        messages = [messages[0]] + messages[cut:]
    if sum(len(str(m.get("content") or "")) for m in messages) <= MAX_CONTEXT_CHARS:
        return messages
    system = messages[:1]
    kept = []
    total = sum(len(str(m.get("content") or "")) for m in system)
    for message in reversed(messages[1:]):
        size = len(str(message.get("content") or ""))
        if kept and total + size > MAX_CONTEXT_CHARS:
            break
        kept.append(message)
        total += size
    return system + list(reversed(kept))


# Compaction starts once a single request's real prompt-token count (as
# reported by the server, not estimated) crosses this fraction of the
# server's actual context window — leaves headroom for the response plus
# whatever gets appended before the next check.
COMPACT_THRESHOLD_RATIO = 0.75
# Tool interactions (an assistant tool_calls message + its tool-result
# response(s)) more recent than this many rounds are never compacted —
# the model is actively reasoning about what just happened.
KEEP_RECENT_TOOL_ROUNDS = 4
# Skip compacting anything this small; not worth replacing with a marker.
COMPACT_MIN_CHARS = 300


def compact_turn_messages(messages, turn_start_index, keep_recent_rounds=KEEP_RECENT_TOOL_ROUNDS):
    """FIFO-compress older tool interactions within the CURRENT turn only.

    Never touches messages before turn_start_index (prior-turn history is
    trim()'s job, between turns). Within this turn, replaces the bulky
    content of tool calls/results older than the most recent
    keep_recent_rounds with a short marker, preserving the record that the
    action happened (so the model doesn't re-do it — the separate
    seen_tool_calls dedup cache also guards against that independently)
    without carrying its full payload. Compresses, does not delete: message
    order and count are unchanged. Returns (messages, chars_saved).
    """
    unit_starts = [
        i for i in range(turn_start_index, len(messages))
        if messages[i].get("role") == "assistant" and messages[i].get("tool_calls")
    ]
    if len(unit_starts) <= keep_recent_rounds:
        return messages, 0

    to_compact_starts = unit_starts[:-keep_recent_rounds]
    chars_saved = 0
    new_messages = list(messages)

    for start in to_compact_starts:
        assistant_msg = new_messages[start]
        tool_call_ids = {tc.get("id") for tc in (assistant_msg.get("tool_calls") or [])}

        compacted_calls = []
        assistant_changed = False
        for tc in assistant_msg.get("tool_calls") or []:
            args_str = tc.get("function", {}).get("arguments") or ""
            if len(args_str) > COMPACT_MIN_CHARS and '"__compacted__"' not in args_str:
                tc = copy.deepcopy(tc)
                fn_name = tc.get("function", {}).get("name", "?")
                tc["function"]["arguments"] = json.dumps({
                    "__compacted__": True,
                    "fn": fn_name,
                    "note": f"{len(args_str):,} chars omitted — already applied earlier this turn",
                })
                chars_saved += len(args_str) - len(tc["function"]["arguments"])
                assistant_changed = True
            compacted_calls.append(tc)
        if assistant_changed:
            assistant_msg = dict(assistant_msg)
            assistant_msg["tool_calls"] = compacted_calls
            new_messages[start] = assistant_msg

        for i in range(start + 1, len(new_messages)):
            m = new_messages[i]
            if m.get("role") != "tool":
                break  # end of this unit's tool results
            if m.get("tool_call_id") not in tool_call_ids:
                continue
            content = m.get("content") or ""
            if len(content) > COMPACT_MIN_CHARS and not content.startswith("[compacted:"):
                marker = f"[compacted: {len(content):,} chars omitted — already applied earlier this turn]"
                new_m = dict(m)
                new_m["content"] = marker
                new_messages[i] = new_m
                chars_saved += len(content) - len(marker)

    return new_messages, chars_saved


