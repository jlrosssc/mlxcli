    global SHOW_THINKING
    model_arg, system, run_task, auto_yes, show_thinking, verify_command, verify_history_dir = parse_args(sys.argv[1:])
    if show_thinking:
        SHOW_THINKING = True
    if auto_yes:
        # Pre-approve every tool category up front — the default now, works for
        # both headless --run and the interactive REPL. Pass --ask to opt back
        # into per-call prompts (see the --ask branch below for the sandbox
        # implication of that).
        ALWAYS_APPROVED.update({"run_command", "write_file", "python_interpreter", "ssh_read", "ssh_write", "ssh_run"})
        # No human is watching each tool call before it runs in this mode, so
        # route the agentic tool-execution layer through the Apple `container`
        # sandbox instead of the host directly (see ensure_sandbox_container).
        global SANDBOX_MODE
        if shutil.which("container"):
            SANDBOX_MODE = True
        else:
            print("  (note: tool calls are auto-approved by default, but Apple's `container` tool wasn't "
                  "found — tool calls will run unsandboxed directly on this machine; pass --ask to review "
                  "each call instead)")
    if not model_arg and not run_task:
        selected_backend = pick_backend(backend)
