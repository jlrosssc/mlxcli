            except urllib.error.HTTPError as e:
                body = e.read().decode(errors="replace")[:400]
                log_error("chat_turn", f"HTTP {e.code} (backend={backend}, model={model}): {body}")
                print(f"[server error {e.code}] {body}")
                return
            except urllib.error.URLError as e:
                log_error("chat_turn", f"connection error (backend={backend}, model={model}): {e.reason}")
                print(f"[connection error] {e.reason}")
                return
            except KeyboardInterrupt:
                print("(interrupted)")
                return
            if not verify_command:
                return
            passed, output = run_verify_suite(verify_command, verify_history_dir)
            if passed:
                print(f"(verification passed, attempt {attempt}/{max_verify_attempts}: {verify_command})")
                return
            print(f"(verification FAILED, attempt {attempt}/{max_verify_attempts}: {verify_command})")
            if output:
