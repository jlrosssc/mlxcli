def maybe_handle_remote_natural_language_action(user, state):
    text = (user or "").strip()
    lowered = text.lower()
    host_match = re.search(r'([A-Za-z0-9._-]+@[A-Za-z0-9._-]+)', text)
    host = host_match.group(1) if host_match else state.get("current_remote")
    if not host:
        return False
    if lowered.startswith("connect to ") and host:
        state["current_remote"] = host
        print(f"(routing to /sshrun {host} whoami)")
        do_sshrun(f"{host} whoami")
        return True
    if host_match:
        state["current_remote"] = host

    cd_match = re.fullmatch(r'(?:cd|use)\s+(/[^ ]+)', text.strip(), re.I)
    if cd_match and host:
        state["current_remote_dir"] = cd_match.group(1)
        print(f"(remote directory: {state['current_remote_dir']})")
        return True

    if any(phrase in lowered for phrase in ("find all", "find files", "list files", "search for")) and (".sh" in lowered or "script" in lowered):
        base = state.get("current_remote_dir") or "/"
        in_match = re.search(r'\bin\s+(/[^ ]+)', text)
        if in_match:
            base = in_match.group(1)
        elif " here" in lowered:
            base = state.get("current_remote_dir") or "/"
        if re.search(r'\bd\*\.sh\b', lowered) or "starting with d" in lowered:
            pattern = r"d.*\.sh$"
        elif re.search(r'\*\.sh\b', lowered) or "all .sh files" in lowered:
            pattern = r"\.sh$"
        else:
            pattern = r"\.sh$"
        state["current_remote_dir"] = base
        print(f"(routing to /sshfind {host}:{base} {pattern})")
        do_sshfind(f"{host}:{base} {pattern}")
        return True

    if "create" in lowered and "script" in lowered and "date" in lowered and "time" in lowered:
        path_match = re.search(r'(/[^ ]+\.(?:sh|bash))', text)
        if path_match:
            path = path_match.group(1)
        else:
            dir_match = re.search(r'in\s+(/[^ ]+)', text)
            name_match = (
                re.search(r'call\w*\s+([A-Za-z0-9._-]+\.(?:sh|bash))', text, re.I)
                or re.search(r'name\w*\s+([A-Za-z0-9._-]+\.(?:sh|bash))', text, re.I)
                or re.search(r'save\s+as\s+([A-Za-z0-9._/-]+\.(?:sh|bash))', text, re.I)
                or re.search(r'\b([A-Za-z0-9._-]+\.(?:sh|bash))\b', text, re.I)
            )
            if dir_match and name_match:
                name = name_match.group(1)
                if name.startswith("/"):
                    path = name
                else:
                    path = str(pathlib.PurePosixPath(dir_match.group(1)) / name)
            elif state.get("current_remote_dir") and name_match:
                name = name_match.group(1)
                if name.startswith("/"):
                    path = name
                else:
                    path = str(pathlib.PurePosixPath(state["current_remote_dir"]) / name)
            else:
                path = "/tmp/script.sh"
        state["current_remote_dir"] = str(pathlib.PurePosixPath(path).parent)
        state["last_remote_path"] = path
        content = "#!/bin/bash\necho \"Current date and time: $(date '+%Y-%m-%d %H:%M:%S')\"\n"
        print(f"(routing to remote write {host}:{path})")
        make_executable = any(term in lowered for term in ("executable", "chmod", "make it executable", "run it", "then run"))
        run_after = any(term in lowered for term in ("run it", "then run", "execute it"))
        if (make_executable or run_after):
            if not write_remote_file_and_maybe_run(host, path, content, make_executable=make_executable, run_after=run_after):
                return True
            return True
        if not write_remote_file(host, path, content):
            return True
        return True

    if any(term in lowered for term in ("make it executable", "chmod it")) and state.get("last_remote_path"):
        path = state["last_remote_path"]
        print(f"(routing to /sshrun {host} chmod +x {path})")
        do_sshrun(f"{host} chmod +x {shlex.quote(path)}")
        return True

    if any(term in lowered for term in ("run it", "execute it")) and state.get("last_remote_path"):
        path = state["last_remote_path"]
        print(f"(routing to /sshrun {host} {path})")
        do_sshrun(f"{host} {shlex.quote(path)}")
        return True
    return False


def find_resume_files_in_downloads(limit=24):
    root = load_default_dir()
    results = []
    for path in sorted(root.rglob("*")):
        if len(results) >= limit:
            break
        if not path.is_file():
            continue
        if any(part.startswith(".") for part in path.relative_to(root).parts):
            continue
        name = path.name.lower()
        if "resume" not in name:
            continue
        if path.suffix.lower() in CONVERTIBLE or path.suffix.lower() in REVIEWABLE_TEXT or path.suffix.lower() in {".pdf"}:
            results.append(path)
    return results


def local_path_hints(user_text):
    text = user_text or ""
    hits = re.findall(r'(?:`([^`]+)`|"([^"]+)"|\'([^\']+)\'|(~/[^\s]+)|(/Users/[^\s]+))', text)
    paths = []
    for backtick, quoted1, quoted2, tilde_path, abs_path in hits:
        candidate = backtick or quoted1 or quoted2 or tilde_path or abs_path
        if candidate:
            paths.append(candidate.rstrip(".,:;"))
    lowered = text.lower()
    if "downloads" in lowered and not paths:
        paths.append(str(load_default_dir()))
    return list(dict.fromkeys(paths))


def remote_specs_in_text(user_text):
    found = re.findall(r'([A-Za-z0-9._-]+@[A-Za-z0-9._-]+:[^\s]+)', user_text or "")
    return list(dict.fromkeys(found))


def infer_filename_term(user_text):
    lowered = (user_text or "").lower()
    if "resume" in lowered:
        return "resume"
    patterns = [
        r'with\s+([A-Za-z0-9._-]+)\s+in the name',
        r'contain(?:ing)?\s+([A-Za-z0-9._-]+)',
        r'named\s+([A-Za-z0-9._-]+)',
    ]
    for pattern in patterns:
        match = re.search(pattern, lowered)
        if match:
            return match.group(1)
    return None


def should_compare_resumes(user_text):
    lowered = (user_text or "").lower()
    return "resume" in lowered and any(term in lowered for term in (
        "compare", "rank", "seniority", "strongest", "weakest",
        "most experience", "most experienced", "years of experience", "experience",
    ))


def should_name_search(user_text):
    lowered = (user_text or "").lower()
    return (
        any(term in lowered for term in (
            "which files", "find files", "list files", "files are in",
            "all files containing", "files containing", "look in downloads for",
        ))
        and ("name" in lowered or "title" in lowered or "contain" in lowered or "resume" in lowered)
    )


def should_preload_file_content(user_text):
    lowered = (user_text or "").lower()
    return any(term in lowered for term in ("read", "review", "inspect", "audit", "summarize", "compare", "check"))


def load_paths_into_context(messages, files, convert_mode, purpose, limit=8):
    labels = []
    for path in files[:limit]:
        try:
            labels.append(append_loaded_file(messages, path, convert_mode))
        except RuntimeError:
            continue
    if labels:
        messages.append({"role": "system", "content": (
            f"Agentic preflight loaded files for {purpose}:\n" + "\n".join(f"- {label}" for label in labels)
        )})
    return labels


def apply_agentic_preflight(user_text, messages, convert_mode):
    notes = []
    if should_compare_resumes(user_text):
        paths = local_path_hints(user_text)
        files = []
        for hint in paths or [str(load_default_dir())]:
            target = pathlib.Path(hint).expanduser()
            if target.is_dir():
                files.extend([p for p in reviewable_paths(target) if "resume" in p.name.lower()][:12])
            elif target.is_file() and "resume" in target.name.lower():
                files.append(target)
        if not files:
            files = find_resume_files_in_downloads(limit=12)
        seen = []
        deduped = []
        for path in files:
            key = str(path)
            if key not in seen:
                seen.append(key)
                deduped.append(path)
        labels = load_paths_into_context(messages, deduped, convert_mode, "resume comparison", limit=8)
        if labels:
            notes.append(f"(agentic preloaded {len(labels)} resume file(s))")
        return notes

    if should_name_search(user_text):
        term = infer_filename_term(user_text)
        roots = local_path_hints(user_text) or [str(load_default_dir())]
        results = []
        if term:
            for root in roots[:3]:
                try:
                    results.extend(namefind_paths(root, term, limit=20))
                except RuntimeError:
                    continue
        if results:
            lines = "\n".join(f"- {path}" for path in results[:30])
            messages.append({"role": "system", "content": (
                f"Agentic filename search found these paths matching '{term}':\n{lines}\n"
                "Use these search results directly for this turn."
            )})
            notes.append(f"(agentic found {min(len(results), 30)} matching file path(s))")
            return notes

    if should_preload_file_content(user_text):
        for hint in local_path_hints(user_text)[:2]:
            target = pathlib.Path(hint).expanduser()
            if target.is_file():
                labels = load_paths_into_context(messages, [target], convert_mode, "local file review", limit=1)
                if labels:
                    notes.append(f"(agentic loaded {labels[0]})")
                    return notes
            elif target.is_dir():
                pattern = "*.y*ml" if "yaml" in (user_text or "").lower() else "*"
                try:
                    files = reviewable_paths(target, pattern)[:6]
                except RuntimeError:
                    files = []
                if files:
                    labels = load_paths_into_context(messages, files, convert_mode, "directory review", limit=6)
                    if labels:
                        notes.append(f"(agentic loaded {len(labels)} file(s) from {target})")
                        return notes

    for spec in remote_specs_in_text(user_text)[:1]:
        lowered = (user_text or "").lower()
        if any(term in lowered for term in ("read", "review", "inspect", "summarize", "check")):
            try:
                host, path = parse_remote_spec(spec)
            except ValueError:
                continue
            if not approve(f"ssh read {host}:{path}", category="ssh_read"):
                notes.append("(agentic remote read declined)")
                return notes
            code, output = run_ssh_command(host, f"cat {shlex.quote(path)}")
            if code == 0 and output:
                clipped = output[:MAX_FILE_CHARS]
                note = "" if len(output) <= MAX_FILE_CHARS else " [truncated to 8000 chars]"
                label = f"{host}:{path}{note}"
                messages.append({"role": "user", "content": f"Contents of remote file {host}:{path}:\n\n{clipped}"})
                messages.append({"role": "system", "content": f"Agentic preflight loaded remote file for review: {label}"})
                notes.append(f"(agentic loaded remote file {host}:{path})")
                return notes
    return notes


def reviewable_paths(folder, pattern=None):
    root = pathlib.Path(folder).expanduser()
    if not root.exists() or not root.is_dir():
        raise RuntimeError(f"folder not found: {root}")
    candidates = sorted(root.rglob(pattern or "*"))
    files = []
    for path in candidates:
        if not path.is_file() or path.name.startswith("."):
            continue
        if any(part.startswith(".") for part in path.relative_to(root).parts):
            continue
        if path.suffix.lower() in CONVERTIBLE or path.suffix.lower() in REVIEWABLE_TEXT:
            files.append(path)
    return files


def review_prompt_for_labels(labels):
    listed = "\n".join(f"- {label}" for label in labels)
    return (
        "Review the provided local file content. Focus on correctness, risks, missing validation, "
        "configuration mistakes, and anything that deserves attention. Keep the review concise and practical.\n\n"
        f"Files under review:\n{listed}"
    )


def do_review(arg, messages, convert_mode):
    try:
        parts = shlex.split(arg)
    except ValueError as e:
        print(f"(couldn't parse /review arguments: {e})")
        return False
    if not parts:
        print("usage: /review PATH [GLOB]")
        return False
    target = pathlib.Path(parts[0]).expanduser()
    pattern = parts[1] if len(parts) > 1 else None
    if target.is_file():
        try:
            text, label = convert_file(target, convert_mode)
        except RuntimeError as e:
            print(f"({e})")
            return False
        clipped = text[:MAX_FILE_CHARS]
        note = "" if len(text) <= MAX_FILE_CHARS else " [truncated to 8000 chars]"
        messages.append({"role": "user", "content": f"Contents of {label}:\n\n{clipped}"})
        messages.append({"role": "user", "content": review_prompt_for_labels([label])})
        print(f"(loaded {label} for review{note})")
        return True
    if target.is_dir():
        files = reviewable_paths(target, pattern)
        if not files:
            shown = pattern or "*"
            print(f"(no reviewable files found in {target} matching {shown})")
            return False
        labels = []
        loaded = 0
        for path in files[:12]:
            try:
                text, label = convert_file(path, convert_mode)
            except RuntimeError as e:
                print(f"({path.name}: {e})")
                continue
            clipped = text[:MAX_FILE_CHARS]
            note = "" if len(text) <= MAX_FILE_CHARS else " [truncated to 8000 chars]"
            messages.append({"role": "user", "content": f"Contents of {label}:\n\n{clipped}"})
            labels.append(f"{label}{note}")
            loaded += 1
        if not loaded:
            print("(no files could be loaded for review)")
            return False
        if len(files) > loaded:
            labels.append(f"... plus {len(files) - loaded} more matching file(s) not loaded")
        messages.append({"role": "user", "content": review_prompt_for_labels(labels)})
        print(f"(loaded {loaded} file(s) from {target} for review)")
        return True
    print(f"(path not found: {target})")
    return False


def append_loaded_file(messages, path, convert_mode):
    text, label = convert_file(path, convert_mode)
    clipped = text[:MAX_FILE_CHARS]
    note = "" if len(text) <= MAX_FILE_CHARS else " [truncated to 8000 chars]"
    messages.append({"role": "user", "content": f"Contents of {label}:\n\n{clipped}"})
    return f"{label}{note}"


