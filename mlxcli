def convert_file(path, mode="auto"):
    if mode not in CONVERT_MODES:
        raise ValueError(f"mode must be one of: {', '.join(sorted(CONVERT_MODES))}")
    p = pathlib.Path(path).expanduser()
    should_convert = mode == "all" or (mode == "auto" and p.suffix.lower() in CONVERTIBLE)
    if should_convert:
        if p.suffix.lower() == ".doc":
            conv = subprocess.run(
                ["/usr/bin/textutil", "-convert", "txt", "-stdout", str(p)],
                capture_output=True,
                text=True,
            )
            if conv.returncode == 0 and conv.stdout.strip():
                return conv.stdout, f"{p.name} (converted via textutil)"
        markitdown = shutil.which("markitdown")
        if not markitdown:
            for candidate in ("/usr/local/bin/markitdown", "/opt/homebrew/bin/markitdown"):
                if pathlib.Path(candidate).exists():
                    markitdown = candidate
                    break
        if not markitdown:
            raise RuntimeError(
                f"markitdown couldn't convert {p.name} — install it with: pip install markitdown"
            )
        conv = subprocess.run([markitdown, str(p)], capture_output=True, text=True)
        if conv.returncode != 0 or not conv.stdout.strip():
            detail = (conv.stderr or conv.stdout or "no output").strip()
            if p.suffix.lower() == ".pdf":
                pdftotext = shutil.which("pdftotext") or "/opt/homebrew/bin/pdftotext"
                if pathlib.Path(pdftotext).exists():
                    pdf_conv = subprocess.run(
                        [pdftotext, "-layout", str(p), "-"],
                        capture_output=True,
                        text=True,
                    )
                    if pdf_conv.returncode == 0 and pdf_conv.stdout.strip():
                        return pdf_conv.stdout, f"{p.name} (converted via pdftotext)"
                    pdf_detail = (pdf_conv.stderr or pdf_conv.stdout or "no output").strip()
                    raise RuntimeError(f"PDF conversion failed for {p.name}:\nmarkitdown: {detail}\npdftotext: {pdf_detail}")
            raise RuntimeError(f"markitdown couldn't convert {p.name}:\n{detail}")
        return conv.stdout, f"{p.name} (converted to markdown)"
    try:
        return p.read_text(errors="replace"), p.name
    except Exception as e:
        raise RuntimeError(f"couldn't read {p}: {e}") from e


def do_mem():
    def sysctl(name):
        try:
            out = subprocess.run(["sysctl", "-n", name], capture_output=True,
                                 text=True, timeout=5).stdout.strip()
            return int(out)
        except Exception:
            return None

    total = sysctl("hw.memsize")
    cap = sysctl("iogpu.wired_limit_mb")
    if total:
        print(f"Total RAM:      {total / 2**30:.1f} GB")
    if cap:
        print(f"Metal cap:      {cap / 1024:.1f} GB (iogpu.wired_limit_mb)")
    try:
        vm = subprocess.run(["vm_stat"], capture_output=True, text=True,
                            timeout=5).stdout
        m = re.search(r"page size of (\d+)", vm)
        page = int(m.group(1)) if m else 16384
        def pages(label):
            mm = re.search(label + r":\s+(\d+)", vm)
            return int(mm.group(1)) * page if mm else 0
        free = pages("Pages free")
        reclaim = free + pages("Pages inactive") + pages("Pages purgeable")
        print(f"Free now:       {free / 2**30:.1f} GB")
        print(f"Reclaimable:    {reclaim / 2**30:.1f} GB (free + inactive + purgeable)")
    except Exception as e:
        print(f"(vm_stat unavailable: {e})")
    try:
        ps = subprocess.run(["ps", "axo", "rss=,comm="], capture_output=True,
                            text=True, timeout=5).stdout.splitlines()
        rows = []
        for line in ps:
            parts = line.strip().split(None, 1)
            if len(parts) == 2 and parts[0].isdigit():
                rows.append((int(parts[0]), parts[1]))
        rows.sort(reverse=True)
        print("Top memory users:")
        shown = 0
        for rss, comm in rows:
            mb = rss // 1024
            if mb < 300 or shown >= 10:
                break
            if ".app/" in comm:
                seg = comm.split("/Applications/")[-1]
                name = seg.split(".app/")[0] if ".app/" in seg else comm.rsplit("/", 1)[-1]
            else:
                name = comm.rsplit("/", 1)[-1]
            tag = "  <- oMLX" if "omlx" in comm.lower() else ""
            print(f"  {mb:>6} MB  {name}{tag}")
            shown += 1
        if shown == 0:
            print("  (nothing over 300 MB)")
    except Exception as e:
        print(f"(ps unavailable: {e})")


def do_resources(totals, messages, last_turn):
    turns = sum(1 for message in messages if message.get("role") == "user")
    print("Dialogue:")
    print(f"  user turns in context: {turns} of {MAX_HISTORY_TURNS}")
    print(f"  last turn tokens:      in {last_turn['in']:,} / out {last_turn['out']:,}")
    print(f"  session tokens:        in {totals['in']:,} / out {totals['out']:,}")
    print(f"  imported file cap:     {MAX_FILE_CHARS:,} chars per file")
    if last_turn["in"] >= 12000:
        print("  guidance: clear or start a new dialogue soon; input context is large")
    elif last_turn["in"] >= 8000:
        print("  guidance: consider /clear after this task; input context is getting heavy")
    elif turns >= MAX_HISTORY_TURNS:
        print("  guidance: retained-turn limit reached; older turns are being trimmed")
    elif turns >= MAX_HISTORY_TURNS - 3:
        print("  guidance: several turns are in context; /clear when this topic is done")
    else:
        print("  guidance: resource use looks reasonable for this dialogue")
    print("  recommendations:")
    for recommendation in resource_recommendations(turns, last_turn["in"]):
        print(f"    - {recommendation}")
    print()
    do_mem()


def resource_recommendations(turns, last_in):
    recommendations = []
    if last_in >= 12000:
        recommendations.append("clear now unless the next question needs this full dialogue")
        recommendations.append("save or export anything important before clearing")
    elif last_in >= 8000:
        recommendations.append("finish the current task, then /clear before changing topics")
        recommendations.append("paste fewer or smaller files, or ask for a summary first")
    elif turns >= MAX_HISTORY_TURNS - 3:
        recommendations.append("clear when this topic is done; older turns will soon be trimmed")
    else:
        recommendations.append("continue normally")
    recommendations.append("start a new dialogue for unrelated work")
    recommendations.append("use /system preset concise for lower-context answers")
    return recommendations


def do_paste(arg, messages, convert_mode):
    raw = arg.strip().strip('"').strip("'")
    if not raw:
        print("usage: /paste <path-to-file>")
        return
    p = pathlib.Path(raw).expanduser()
    if not p.exists():
        print(f"(file not found: {p})")
        hits = list(p.parent.glob(p.name + "*")) if p.parent.exists() else []
        for h in hits[:5]:
            print(f"  did you mean: {h}")
