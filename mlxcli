            if attempt == max_verify_attempts:
                log_error("chat_turn", f"verification exhausted after {max_verify_attempts} attempts (backend={backend}, model={model}): {verify_command}")
                print(f"(giving up after {max_verify_attempts} verification attempts)")
                return
            messages.append({"role": "user", "content": (
