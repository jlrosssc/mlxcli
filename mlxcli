def parse_markdown_table(markdown):
    lines = [line.rstrip() for line in (markdown or "").splitlines()]
    tables = []
    i = 0
    while i < len(lines) - 1:
        if "|" not in lines[i] or "|" not in lines[i + 1]:
            i += 1
            continue
        header = [cell.strip() for cell in lines[i].strip().strip("|").split("|")]
        sep_cells = [cell.strip() for cell in lines[i + 1].strip().strip("|").split("|")]
        if len(header) < 2 or not all(re.fullmatch(r":?-{3,}:?", cell) for cell in sep_cells if cell):
            i += 1
            continue
        rows = []
        j = i + 2
        while j < len(lines) and "|" in lines[j]:
            row = [cell.strip() for cell in lines[j].strip().strip("|").split("|")]
            if len(row) == len(header):
                rows.append(row)
                j += 1
            else:
                break
        tables.append((header, rows))
        i = j
    return tables


def write_csv_from_table(out, header, rows):
    def esc(cell):
        cell = cell.replace('"', '""')
        return f'"{cell}"'
    lines = [",".join(esc(c) for c in header)]
    lines.extend(",".join(esc(c) for c in row) for row in rows)
    out.write_text("\n".join(lines) + "\n")


def col_letter(n):
    result = ""
    while n > 0:
        n, rem = divmod(n - 1, 26)
        result = chr(65 + rem) + result
    return result


