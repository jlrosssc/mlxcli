    target = pathlib.Path(raw).expanduser() if raw else pathlib.Path.cwd()
    if not target.exists():
        print(f"(path not found: {target})")
        return
    if target.is_file():
        print(target)
        return
    entries = sorted(target.iterdir(), key=lambda p: (p.is_file(), p.name.lower()))
    if not entries:
        print(f"(empty directory: {target})")
        return
    print(f"{target}:")
    for entry in entries[:80]:
        suffix = "/" if entry.is_dir() else ""
        print(f"  {entry.name}{suffix}")
    if len(entries) > 80:
        print(f"  ... plus {len(entries) - 80} more")


def do_find(arg):
    try:
        parts = shlex.split(arg)
    except ValueError as e:
        print(f"(couldn't parse /find arguments: {e})")
        return
    if len(parts) < 2:
        print("usage: /find PATH PATTERN")
        return
    target = pathlib.Path(parts[0]).expanduser()
    pattern = parts[1]
    if not target.exists():
        print(f"(path not found: {target})")
        return
    if target.is_file():
        candidates = [target]
    else:
        candidates = [
            p for p in sorted(target.rglob("*"))
            if p.is_file() and not any(part.startswith(".") for part in p.relative_to(target).parts)
        ]
    regex = re.compile(pattern, re.IGNORECASE)
    hits = []
    scanned = 0
    for path in candidates:
        if path.suffix.lower() not in REVIEWABLE_TEXT:
            continue
        scanned += 1
        if scanned > 500:
            break
        try:
            text, _label = convert_file(path, "off")
        except Exception:
            continue
        for i, line in enumerate(text.splitlines(), start=1):
            if regex.search(line):
                hits.append(f"{path}:{i}: {line.strip()[:180]}")
                if len(hits) >= 60:
                    break
        if len(hits) >= 60:
            break
    if not hits:
        print("(no matches)")
        return
    print_section("matches:", hits)
    if scanned > 500:
        print("  ... search capped at 500 text files")


def namefind_paths(root, term, limit=60):
    base = pathlib.Path(root).expanduser()
    if not base.exists():
        raise RuntimeError(f"path not found: {base}")
    if base.is_file():
        return [base] if term.lower() in base.name.lower() else []
    matches = []
    for path in sorted(base.rglob("*")):
        if len(matches) >= limit:
            break
        if not path.is_file():
            continue
        if any(part.startswith(".") for part in path.relative_to(base).parts):
            continue
        if term.lower() in path.name.lower():
            matches.append(path)
    return matches


def do_namefind(arg):
    try:
        parts = shlex.split(arg)
    except ValueError as e:
        print(f"(couldn't parse /namefind arguments: {e})")
        return
    if len(parts) < 2:
        print("usage: /namefind PATH PATTERN")
        return
    try:
        matches = namefind_paths(parts[0], parts[1])
    except RuntimeError as e:
        print(f"({e})")
        return
    if not matches:
        print("(no filename matches)")
        return []
    print_section("filename matches:", [str(path) for path in matches])
    return matches


