def read_single_key(prompt, valid_chars, default=""):
    """Read one keypress and return it immediately, no Enter required.
    Falls back to line-buffered input() when stdin isn't a real terminal
    (e.g. piped/scripted input), where raw keypresses aren't available."""
    print(prompt, end="", flush=True)
    if not sys.stdin.isatty():
        try:
            line = input().strip().lower()
        except KeyboardInterrupt:
            print()
            raise
        result = line[:1] if line else default
        return result
    fd = sys.stdin.fileno()
    old = termios.tcgetattr(fd)
    try:
        tty.setcbreak(fd)
        while True:
            ch = sys.stdin.read(1)
            if ch in ("\r", "\n"):
                ch = default
                break
            if ch == "\x03":
                raise KeyboardInterrupt
            if ch.lower() in valid_chars:
                ch = ch.lower()
                break
            # unrecognized key: ignore and keep waiting rather than erroring
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old)
    print(ch)
    return ch


# Tool categories the user has approved "always" for the rest of this session,
# mirroring Claude Code's "don't ask again for this kind of action" behavior.
ALWAYS_APPROVED = set()

# Opt-in sandboxing: when -y/--yes bypasses the interactive approval prompts,
# route run_command/python_interpreter/write_file through an Apple `container`
# instance instead of the host directly, so a runaway or malicious tool call
# can't touch anything outside the working directory. Normal reviewed
# sessions (no -y) are never sandboxed — the diff preview + human approval
# already gates those, same as always.
SANDBOX_MODE = False
SANDBOX_IMAGE = "mlxcli-sandbox:latest"
SANDBOX_CONTAINER_NAME = f"mlxcli-sandbox-{os.getpid()}"
_sandbox_started = False


def ensure_sandbox_container():
    """Start the sandbox container on first use (idempotent). The working
    directory is bind-mounted at /workspace so writes there are visible on
    the host in real time; writes elsewhere land only in the container's
    own ephemeral filesystem and vanish with it. Disables SANDBOX_MODE for
    the rest of the session (falling back to direct host execution, same as
    a plain -y run today) if the container tool isn't actually available."""
    global _sandbox_started, SANDBOX_MODE
    if _sandbox_started or not SANDBOX_MODE:
        return
    workdir = load_default_dir().resolve()
    subprocess.run(["container", "delete", "-f", SANDBOX_CONTAINER_NAME],
                    capture_output=True)  # clear a stale container from a crashed prior run
    try:
        p = subprocess.run(
            ["container", "run", "-d", "--name", SANDBOX_CONTAINER_NAME,
             "-v", f"{workdir}:/workspace", "-w", "/workspace",
             SANDBOX_IMAGE, "sleep", "infinity"],
            capture_output=True, text=True, timeout=60)
    except (FileNotFoundError, subprocess.TimeoutExpired) as e:
        print(f"  (sandbox container failed to start ({e}) — falling back to unsandboxed execution)")
        SANDBOX_MODE = False
        return
    if p.returncode != 0:
        print(f"  (sandbox container failed to start: {p.stderr.strip()} — falling back to unsandboxed execution)")
        SANDBOX_MODE = False
        return
    _sandbox_started = True
    print(f"  (sandbox container started: {SANDBOX_CONTAINER_NAME}, workspace={workdir})")


def teardown_sandbox_container():
    global _sandbox_started
    if not _sandbox_started:
        return
    subprocess.run(["container", "stop", SANDBOX_CONTAINER_NAME], capture_output=True, timeout=30)
    subprocess.run(["container", "delete", "-f", SANDBOX_CONTAINER_NAME], capture_output=True, timeout=30)
    _sandbox_started = False


atexit.register(teardown_sandbox_container)


def sandbox_container_path(target):
    """Map a resolved host path to its path inside the sandbox container.
    Paths inside the bind-mounted working directory map to /workspace/...
    so the write is visible on the host; anything else stays as a literal
    path inside the container's own ephemeral filesystem — i.e. it never
    reaches the host at all."""
    root = load_default_dir().resolve()
    try:
        rel = target.relative_to(root)
        return str(pathlib.PurePosixPath("/workspace") / rel)
    except ValueError:
        return str(target)


def sandbox_rewrite_command(cmd):
    """Rewrite host absolute-path references to the working directory inside
    a shell command string so they resolve inside the container. The model's
    own system prompt tells it to use the real host path (e.g.
    /Users/dad/LocalAI) for anything in the working directory — that path
    doesn't exist inside the container, only its bind-mount target
    (/workspace) does, so a command using it verbatim would otherwise fail
    with a spurious 'No such file or directory'. Only rewrites the working
    directory prefix; a command referencing some other host path outside it
    is left as-is (see sandbox_container_path's docstring for why)."""
    root = str(load_default_dir().resolve())
    # Match the root path only at a token boundary (end of string, or
    # followed by /, whitespace, or a quote) so a sibling directory that
    # merely shares the prefix (e.g. /Users/dad/LocalAI2) isn't mangled.
    pattern = re.escape(root) + r'(?=$|[/\s\'"])'
    return re.sub(pattern, "/workspace", cmd)

# When on, prints the model's own prose at each retry step of an agentic turn
# (normally swallowed behind a terse status line), and its prose alongside a
# tool call in the same turn. This backend doesn't expose a separate
# reasoning/thinking token stream — there's no hidden chain-of-thought to
# surface — so this is "don't hide what it actually said," not literal
# chain-of-thought.
SHOW_THINKING = False


def approve(desc, category=None):
    if category and category in ALWAYS_APPROVED:
        print(f"  approve: {desc} [auto-approved: {category}]")
        return True
    ch = read_single_key(f"  approve: {desc} [y/N/a=always allow {category or 'this'}] ",
                         {"y", "n", "a"}, default="n")
    if ch == "a":
        if category:
            ALWAYS_APPROVED.add(category)
            print(f"  (will auto-approve {category} actions for the rest of this session)")
        # "Always allow" means the same thing -y does from here on: nothing
        # reviews this category's tool calls before they run, so it gets the
        # same sandbox protection -y gets — for the whole rest of the session,
        # not just this category, since the sandbox container is one shared
        # instance rather than scoped per tool category.
        global SANDBOX_MODE
        if not SANDBOX_MODE:
            if shutil.which("container"):
                SANDBOX_MODE = True
                print("  (switching the rest of this session to sandboxed execution — "
                      "auto-approved actions no longer get human review, so they "
                      "shouldn't touch the real filesystem unreviewed either)")
            else:
                print("  (note: Apple's `container` tool wasn't found, so auto-approved "
                      "actions will still run unsandboxed directly on this machine)")
        return True
    return ch == "y"


# infer_command_cwd is imported from mlxlib (shared with mlxgui).


def exec_tool(name, args):
    # Some local backends qualify function names as shell:run_command or shell.run_command.
    # Normalize those names before dispatching so valid tool calls are not silently lost.
    raw_name = str(name or "")
    normalized_name = raw_name.strip().lower().replace("/", ":").replace(".", ":")
    name = normalized_name.rsplit(":", 1)[-1]
    if name == "run_command":
        cmd = args.get("command", "")
        print(f"  tool: run_command ({cmd})")
        try:
            mkdir_parts = shlex.split(cmd)
        except ValueError:
            mkdir_parts = []
        if mkdir_parts[:2] == ["mkdir", "-p"] and len(mkdir_parts) > 2:
            root = load_default_dir().resolve()
            targets = [pathlib.Path(part).expanduser().resolve(strict=False) for part in mkdir_parts[2:]]
            if all(target.is_relative_to(root) for target in targets) and all(target.exists() for target in targets):
                return "exit_code=0\n(no action; requested directories already exist)"
        if not approve(f"run: {cmd}", category="run_command"):
            return "User declined."
        try:
            if SANDBOX_MODE:
                ensure_sandbox_container()
            if SANDBOX_MODE and _sandbox_started:
                sandboxed_cmd = sandbox_rewrite_command(cmd)
                p = subprocess.run(["container", "exec", SANDBOX_CONTAINER_NAME, "sh", "-c", sandboxed_cmd],
                                   capture_output=True, text=True, timeout=180)
                location = "\nworking_directory=/workspace (sandboxed)"
            else:
                cwd = infer_command_cwd(cmd)
                p = subprocess.run(cmd, shell=True, capture_output=True,
                                   text=True, timeout=180, cwd=cwd)
                location = f"\nworking_directory={cwd}" if cwd else ""
            out = (p.stdout + p.stderr).strip()
            return f"exit_code={p.returncode}{location}\n{out[:MAX_FILE_CHARS] if out else '(no output)'}"
        except subprocess.TimeoutExpired:
            return "Command timed out."
    if name == "python_interpreter":
        code = args.get("code", "")
        print("  tool: python_interpreter")
        if any(term in code for term in ("open(", "write_text(", "makedirs(", "mkdir(", "os.remove(", "unlink(")):
            return "Error: use write_file for file creation and run_command for execution; python_interpreter is disabled for filesystem writes."
        if not approve(f"run Python code ({len(code)} chars)", category="python_interpreter"):
            return "User declined."
        try:
            if SANDBOX_MODE:
                ensure_sandbox_container()
            if SANDBOX_MODE and _sandbox_started:
                sandboxed_code = sandbox_rewrite_command(code)
                p = subprocess.run(["container", "exec", SANDBOX_CONTAINER_NAME, "python3", "-c", sandboxed_code],
                                   capture_output=True, text=True, timeout=180)
            else:
                p = subprocess.run([sys.executable, "-c", code], capture_output=True,
                                   text=True, timeout=180)
            out = (p.stdout + p.stderr).strip()
            return f"exit_code={p.returncode}\n{out[:MAX_FILE_CHARS] if out else '(no output)'}"
        except subprocess.TimeoutExpired:
            return "Python execution timed out."
    if name == "read_file":
        print(f"  tool: read_file ({args.get('path', '')})")
        target = pathlib.Path(args["path"]).expanduser()
        if target.is_dir():
            return (f"Error: {target} is a directory, not a file. "
                    f"Use run_command with 'ls' or 'find' to see its contents.")
        try:
            text = target.read_text()
            note = "" if len(text) <= MAX_FILE_CHARS else "\n[truncated]"
            print(f"  read: {args['path']} ({len(text)} chars)")
            return text[:MAX_FILE_CHARS] + note
        except Exception as e:
            return f"Error: {e}"
    if name == "write_file":
        path = args.get("path", "")
        content = args.get("content", args.get("text", ""))
        print(f"  tool: write_file ({path})")
        try:
            target = resolve_output_path(path)
        except ValueError as e:
            return f"Error: {e}"
        old = ""
        if target.exists():
            try:
                old = target.read_text(errors="replace")
            except Exception:
                old = ""
        if target.suffix == ".py" and target.exists() and "zcta" in old.lower() and re.search(r"\bzzcta\b", content, re.IGNORECASE):
            return "Error: rejected suspicious overwrite; proposed Python content changes zcta to zzcta in an existing validated script. Inspect and preserve the existing file."
        # Existing-file overwrites are gated by the interactive approve() prompt below
        # (which shows the diff), not by guessing intent from the request's wording —
        # that keyword-based pre-check silently blocked legitimate requests more than
        # once and is not a reliable signal of what the user actually wants.
        diff = list(difflib.unified_diff(
            old.splitlines(), content.splitlines(),
            fromfile=f"{path} (current)", tofile=f"{path} (proposed)",
            lineterm=""))
        if diff:
            print("  --- proposed change ---")
            for line in diff[:80]:
                print(f"  {line}")
            if len(diff) > 80:
                print(f"  ... ({len(diff) - 80} more diff lines)")
        else:
            print("  (no textual change)")
        if not approve(f"write {len(content)} chars to {target}", category="write_file"):
            return "User declined."
        in_workspace = True
        try:
            target.relative_to(load_default_dir().resolve())
        except ValueError:
            in_workspace = False
        if SANDBOX_MODE and not in_workspace:
            ensure_sandbox_container()
            if _sandbox_started:
                container_path = sandbox_container_path(target)
                p = subprocess.run(
                    ["container", "exec", "-i", SANDBOX_CONTAINER_NAME, "python3", "-c",
                     "import pathlib,sys\n"
                     "p = pathlib.Path(sys.argv[1])\n"
                     "p.parent.mkdir(parents=True, exist_ok=True)\n"
                     "p.write_text(sys.stdin.read())\n"
                     "print(p.stat().st_size)",
                     container_path],
                    input=content, capture_output=True, text=True, timeout=60)
                if p.returncode == 0:
                    return (f"Written: {container_path} ({p.stdout.strip()} bytes) inside the sandbox only "
                            f"— this path is outside the working directory, so nothing was written to the "
                            f"real host filesystem.")
                return f"Error writing inside sandbox: {p.stderr.strip()}"
        backup_path = backup_before_overwrite(target) if diff else None
        try:
            target.parent.mkdir(parents=True, exist_ok=True)
            target.write_text(content)
            note = f" (previous version backed up to {backup_path})" if backup_path else ""
            result = f"Written: {target} ({target.stat().st_size} bytes).{note}"
            if target.suffix == ".py":
                syntax_error = python_syntax_error(content)
                if syntax_error:
                    return (f"{result} Error: this file has a Python syntax error and will not run "
                            f"({syntax_error}) — likely truncated mid-generation. Rewrite it completely with write_file.")
                missing = missing_local_imports(target)
                if missing:
                    plural = "s" if len(missing) > 1 else ""
                    return (f"{result} Warning: this file imports {', '.join(missing)}, which "
                            f"{'are' if plural else 'is'} neither a standard-library module nor installed, and "
                            f"{'have' if plural else 'has'} no matching file yet in {target.parent}. "
                            "If it's meant to be a local module, write it now with write_file. If it's a "
                            "third-party package, install it first with run_command (pip install ...) or state "
                            "that it's a required dependency — do not report completion either way until resolved.")
            return result
        except Exception as e:
            return f"Error: {e}"
    return "Unknown tool."


