# Reverse lookup: any known name/alias (lowercased) -> (canonical, [all forms])
_BIBLE_BOOK_LOOKUP = {}
for _canonical, _aliases in BIBLE_BOOK_ALIASES.items():
    _all_forms = [_canonical] + _aliases
    for _form in _all_forms:
        _BIBLE_BOOK_LOOKUP[_form.lower()] = (_canonical, _all_forms)


def expand_bible_reference_query(query):
    """If query starts with a recognized Bible book name/alias followed by a
    reference (e.g. 'John 3:16', 'Gospel of John 3:16', 'Jn 3:16-18'), return
    one query variant per known form of that book so a search can try them
    all and merge results. Otherwise return [query] unchanged — this only
    ever adds variants, never changes behavior for non-reference queries or
    any non-Bible collection."""
    words = query.split()
    for word_count in (3, 2, 1):
        if word_count > len(words):
            continue
        candidate = " ".join(words[:word_count])
        rest = " ".join(words[word_count:])
        match = _BIBLE_BOOK_LOOKUP.get(candidate.lower())
        if match and rest:
            _canonical, all_forms = match
            return [f"{form} {rest}" for form in all_forms]
    return [query]


# All known book forms, longest first (so "Song of Solomon" matches before
# "Song"), for finding a reference embedded anywhere in a normal sentence —
# not just when it's the whole query, unlike expand_bible_reference_query above.
_BIBLE_BOOK_FORMS_BY_LENGTH = sorted(_BIBLE_BOOK_LOOKUP.keys(), key=len, reverse=True)
_EMBEDDED_REFERENCE_RE = re.compile(
    r"\b(" + "|".join(re.escape(f) for f in _BIBLE_BOOK_FORMS_BY_LENGTH) + r")\s+"
    r"(\d+(?::\d+(?:-\d+)?)?)\b",
    re.IGNORECASE)


def find_embedded_bible_reference(text):
    """Find a Bible reference anywhere in a normal sentence (e.g. 'show me
    commentary on John 3:16 please') and return its expanded query variants,
    or None if no reference is found. This is what lets a plain chat message
    that happens to mention a reference get a targeted search instead of the
    whole sentence — including its filler words — being used as one literal,
    almost-certainly-losing query."""
    m = _EMBEDDED_REFERENCE_RE.search(text)
    if not m:
        return None
    return expand_bible_reference_query(f"{m.group(1)} {m.group(2)}")


_COLLECTION_PHRASE_START_RE = re.compile(r"^\s*from\s+(?:the\s+)?(?:rag\s+)?(.+)$", re.IGNORECASE)
# Leading instruction phrasing that never appears in real source text, so it
# should be stripped before the remainder is used as a search query — e.g.
# "list all references to due process" -> "due process".
_INSTRUCTION_FILLER_RE = re.compile(
    r"^\s*(?:please\s+)?(?:show|list|find|search(?:\s+for)?|give\s+me|tell\s+me\s+about)"
    r"(?:\s+(?:me|all|any))*(?:\s+references?)?(?:\s+(?:to|about|for|of|on))?\s+", re.IGNORECASE)


def detect_natural_language_collection(text, url, key):
    """Parse a leading 'from COLLECTION, ...' or 'from rag COLLECTION ...'
    phrase, fuzzy-matched (typo-tolerant) against the real, current
    collection list fetched live from the server — never a hardcoded name
    list, so this keeps working for whatever collections exist. Tries
    candidate lengths from longest to shortest (up to 4 words) so a
    multi-word, comma-less name like 'founding documenets list all...' still
    resolves to the 2-word collection name rather than matching just the
    first word. Returns (matched_collection_name, remaining_query_with_
    filler_stripped), or None if no recognizable 'from X' phrase is found or
    nothing fuzzy-matches a real collection well enough."""
    start = _COLLECTION_PHRASE_START_RE.match(text)
    if not start:
        return None
    remainder = start.group(1).strip()
    try:
        real_names = [c.get("collection") for c in rag_remote_collections(url, key).get("collections", [])]
    except Exception:
        return None
    real_names = [n for n in real_names if n]
    if not real_names:
        return None
    lower_map = {n.lower(): n for n in real_names}
    words = remainder.split()
    best = None  # (score, matched_name, rest_text)
    for word_count in range(min(4, len(words)), 0, -1):
        candidate = " ".join(words[:word_count]).rstrip(",:")
        rest = " ".join(words[word_count:])
        if not rest:
            continue
        close = difflib.get_close_matches(candidate.lower(), lower_map.keys(), n=1, cutoff=0.6)
        if close:
            score = difflib.SequenceMatcher(None, candidate.lower(), close[0]).ratio()
            if best is None or score > best[0]:
                best = (score, lower_map[close[0]], rest)
    if not best:
        return None
    _score, matched_name, rest = best
    stripped = _INSTRUCTION_FILLER_RE.sub("", rest).strip() or rest
    return matched_name, stripped


