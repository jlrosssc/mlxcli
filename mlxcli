def do_sshfind(arg):
    try:
        parts = shlex.split(arg)
    except ValueError as e:
        print(f"(couldn't parse /sshfind arguments: {e})")
        return
    if len(parts) < 2:
        print("usage: /sshfind USER@HOST:PATH PATTERN")
        return
    try:
        host, path = parse_remote_spec(parts[0])
    except ValueError as e:
        print(f"({e})")
        return
    pattern = parts[1]
    if not approve(f"ssh find {host}:{path} pattern {pattern}", category="ssh_read"):
        print("(declined)")
        return
    remote_cmd = (
        f"find {shlex.quote(path)} -type f "
        f"\\( -name '*.txt' -o -name '*.md' -o -name '*.yaml' -o -name '*.yml' -o -name '*.json' "
        f"-o -name '*.toml' -o -name '*.ini' -o -name '*.cfg' -o -name '*.py' -o -name '*.sh' \\) "
        f"-print0 | xargs -0 grep -nEi {shlex.quote(pattern)} | head -60"
    )
    code, output = run_ssh_command(host, remote_cmd)
    if code != 0 and not output:
        print("(ssh find failed)")
        return
    print(output or "(no matches)")


def do_sshwrite(arg):
    raw = arg.strip()
    if not raw:
        print("usage: /sshwrite USER@HOST:PATH")
        return
    try:
        host, path = parse_remote_spec(raw)
    except ValueError as e:
        print(f"({e})")
        return
    print("(enter remote file content, then finish with a single line containing only EOF)")
    lines = []
    while True:
        try:
            line = input("")
        except (EOFError, KeyboardInterrupt):
            print("\n(cancelled)")
            return
        if line == "EOF":
            break
        lines.append(line)
    content = "\n".join(lines) + ("\n" if lines else "")
    if not approve(f"ssh write {len(content)} chars to {host}:{path}", category="ssh_write"):
        print("(declined)")
        return
    remote_cmd = f"mkdir -p {shlex.quote(str(pathlib.PurePosixPath(path).parent))} && cat > {shlex.quote(path)}"
    code, output = run_ssh_command_with_input(host, remote_cmd, content)
    if code != 0:
        print(f"(ssh write failed)\n{output}")
        return
    print(f"(wrote remote file {host}:{path})")


def write_remote_file(host, path, content):
    if not approve(f"ssh write {len(content)} chars to {host}:{path}", category="ssh_write"):
        print("(declined)")
        return False
    remote_cmd = f"mkdir -p {shlex.quote(str(pathlib.PurePosixPath(path).parent))} && cat > {shlex.quote(path)}"
    code, output = run_ssh_command_with_input(host, remote_cmd, content)
    if code != 0:
        print(f"(ssh write failed)\n{output}")
        return False
    print(f"(wrote remote file {host}:{path})")
    return True


def write_remote_file_and_maybe_run(host, path, content, make_executable=False, run_after=False):
    actions = [f"write {len(content)} chars to {host}:{path}"]
    if make_executable:
        actions.append("chmod +x")
    if run_after:
        actions.append("run")
    if not approve(f"ssh {'; '.join(actions)}", category="ssh_write"):
        print("(declined)")
        return False
    remote_parts = [
        f"mkdir -p {shlex.quote(str(pathlib.PurePosixPath(path).parent))}",
        f"cat > {shlex.quote(path)}",
    ]
    if make_executable:
        remote_parts.append(f"chmod +x {shlex.quote(path)}")
    if run_after:
        remote_parts.append(shlex.quote(path))
    remote_cmd = " && ".join(remote_parts)
    code, output = run_ssh_command_with_input(host, remote_cmd, content)
    if code != 0 and not output:
        print("(ssh write/run failed)")
        return False
    print(f"(wrote remote file {host}:{path})")
    if make_executable:
        print(f"(made executable {host}:{path})")
    if run_after and output:
        print(output)
    elif run_after:
        print("(no output)")
    return code == 0


