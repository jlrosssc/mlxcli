def do_save(arg, messages, model):
    raw = arg.strip().strip('"')
    if raw:
        out = resolve_output_path(raw)
    else:
        stamp = time.strftime("%Y%m%d-%H%M%S")
        out = DOWNLOADS / f"mlxcli-{stamp}.md"
    lines = [f"# mlxcli session — {time.strftime('%Y-%m-%d %H:%M')} — model: {model}\n"]
    for m in messages:
        role = m.get("role")
        content = m.get("content") or ""
        if role == "system" or not content:
            continue
        title = {"user": "You", "assistant": "Model", "tool": "Tool output"}.get(role, role)
        lines.append(f"## {title}\n\n{content}\n")
    try:
        out.parent.mkdir(parents=True, exist_ok=True)
        out.write_text("\n".join(lines))
        print(f"(saved transcript to {out})")
    except Exception as e:
        print(f"(couldn't save: {e})")


def do_export(arg, messages):
    content = ""
    for message in reversed(messages):
        if message.get("role") == "assistant" and message.get("content"):
            content = message["content"]
            break
    if not content:
        print("(there is no model reply to export yet)")
        return
    raw = arg.strip().strip('"')
    if raw:
        out = resolve_output_path(raw)
    else:
        stamp = time.strftime("%Y%m%d-%H%M%S")
        out = DOWNLOADS / f"mlxcli-reply-{stamp}.docx"
    if not out.suffix:
        out = out.with_suffix(".docx")
    try:
        out.parent.mkdir(parents=True, exist_ok=True)
        suffix = out.suffix.lower()
        if suffix == ".docx":
            markdown_to_docx(out, "mlxcli Export", content)
        elif suffix == ".md":
            out.write_text(content)
        elif suffix == ".txt":
            out.write_text(markdown_to_text(content))
        else:
            out.write_text(content)
        print(f"(exported latest reply to {out})")
    except Exception as e:
        print(f"(couldn't export: {e})")


def do_copy(messages):
    content = ""
    for message in reversed(messages):
        if message.get("role") == "assistant" and message.get("content"):
            content = message["content"]
            break
    if not content:
        print("(there is no model reply to copy yet)")
        return
    blocks = re.findall(r"```(?:[a-zA-Z0-9_+-]*)\n(.*?)```", content, re.S)
    payload = blocks[-1].rstrip("\n") if blocks else content
    try:
        subprocess.run(["pbcopy"], input=payload.encode(), check=True)
        label = "last code block" if blocks else "full reply"
        print(f"(copied {label} — {len(payload)} chars — to clipboard)")
    except Exception as e:
        print(f"(couldn't copy: {e})")


def usage_counts(usage):
    if not usage:
        return 0, 0
    in_tokens = usage.get("prompt_tokens")
    out_tokens = usage.get("completion_tokens")
    if in_tokens is None:
        in_tokens = usage.get("input_tokens", 0)
    if out_tokens is None:
        out_tokens = usage.get("output_tokens", 0)
    return int(in_tokens or 0), int(out_tokens or 0)


def complete_once(url, key, model, messages, backend, max_tokens=MAX_RESPONSE_TOKENS):
    settings = load_model_settings(backend)
    payload = {
        "model": model,
        "messages": collapse_system_messages(messages) if is_turbo_backend(backend) else messages,
        "max_tokens": max_tokens,
        "stream": False,
        "temperature": settings["temperature"],
        "top_p": settings["top_p"],
        "top_k": settings["top_k"],
        "repetition_penalty": settings["repetition_penalty"],
    }
    data = api(url, key, "/v1/chat/completions", payload)
    choices = data.get("choices") or []
    if not choices:
        return "", {}
    message = choices[0].get("message") or {}
    return message.get("content", "") or "", data.get("usage") or {}


def build_resume_batches(files, convert_mode, char_budget=MAX_BATCH_RESUME_CHARS, max_files=5):
    batches = []
    current = []
    current_chars = 0
    for path in files:
        try:
            text, label = convert_file(path, convert_mode)
        except RuntimeError as e:
            print(f"({path.name}: {e})")
            continue
        clipped = text[:MAX_FILE_CHARS]
        size = len(clipped)
        if current and (current_chars + size > char_budget or len(current) >= max_files):
            batches.append(current)
            current = []
            current_chars = 0
        current.append((path, label, clipped))
        current_chars += size
    if current:
        batches.append(current)
    return batches


def summarize_resume_batch(url, key, model, backend, batch, batch_index, batch_total):
    listed = "\n\n".join(f"Resume file: {label}\n\n{text}" for _, label, text in batch)
    messages = [
        {"role": "system", "content": (
            "You are extracting structured summaries from resumes. "
            "Do not omit candidates. Be concise and factual. "
            "For each resume, output one bullet with: Name | Approx years of experience | Evidence | 1 short note."
        )},
        {"role": "user", "content": (
            f"Summarize every resume in batch {batch_index}/{batch_total}. "
            "Use candidate names, not filenames, when the name is available.\n\n"
            f"{listed}"
        )},
    ]
    return complete_once(url, key, model, messages, backend, max_tokens=1800)


def resume_compare_batched(url, key, model, backend, files, convert_mode, user_request):
    start = time.time()
    batches = build_resume_batches(files, convert_mode)
    if not batches:
        return "", 0, 0, time.time() - start
    batch_summaries = []
    total_in = 0
    total_out = 0
    for index, batch in enumerate(batches, start=1):
        print(f"(resume batch {index}/{len(batches)}: {len(batch)} file(s))")
        summary, usage = summarize_resume_batch(url, key, model, backend, batch, index, len(batches))
        in_tokens, out_tokens = usage_counts(usage)
        total_in += in_tokens
        total_out += out_tokens
        if summary:
            batch_summaries.append(f"Batch {index} summaries:\n{summary}")
    if not batch_summaries:
        return "", total_in, total_out, time.time() - start
    final_messages = [
        {"role": "system", "content": (
            "You are combining batched resume summaries into one final answer. "
            "Use only the provided summaries. Be concise and definitive."
        )},
        {"role": "user", "content": (
            f"Using these batched resume summaries, respond to this request:\n{user_request}\n\n"
            + "\n\n".join(batch_summaries)
        )},
    ]
    final_content, usage = complete_once(url, key, model, final_messages, backend, max_tokens=1800)
    in_tokens, out_tokens = usage_counts(usage)
    total_in += in_tokens
    total_out += out_tokens
    return final_content, total_in, total_out, time.time() - start


def print_tokens(label, in_tokens, out_tokens, elapsed=None):
    rate = f" / {out_tokens / elapsed:.1f} tok/s" if elapsed and elapsed > 0 and out_tokens > 0 else ""
    print(f"[tokens: in {in_tokens:,} / out {out_tokens:,}{rate}]", flush=True)


