def compact_refinement_context(messages, max_chars=9000):
    """Provide only the recent user/assistant exchange needed to resolve follow-ups."""
    parts = []
    for message in messages[1:]:
        role = message.get("role")
        content = (message.get("content") or "").strip()
        if role not in {"user", "assistant"} or not content:
            continue
        parts.append(f"{role.title()} message:\n{content[:4500]}")
    return "\n\n".join(parts[-4:])[-max_chars:]


def refine_request(url, key, model, backend, raw_request, context=""):
    """Convert an ambiguous request into a compact executable request using limited context."""
    refiner_system = (
        "You are a prompt decoder, not the task solver. Rewrite the user's request into one precise prompt for another LLM.\n"
        "Return only the rewritten prompt, with no preamble, analysis, or commentary.\n"
        "Preserve every literal filename, path, number, code, quoted value, list item, and requested output column.\n"
        "Do not invent missing inputs or facts. If the request refers to missing content, explicitly state that the input is missing.\n"
        "Use the supplied recent context only to resolve references such as 'these', 'each', 'above', or 'the previous result'; "
        "do not treat context as a new task unless the current request refers to it.\n"
        "Resolve intent into: objective, resources, exact operation, constraints, preservation/order rules, and output format.\n"
        "For matching or lookup tasks, require full-key matching and repeat any normalization rule exactly; never weaken it to suffix or similarity matching.\n"
        "For local file listings or size rankings, recommend find with stat and byte-based sorting; never rely on ls with positional awk fields because filenames may contain spaces.\n"
        "For file metadata such as creation dates, require stat on the exact files and never infer dates from names or prior text.\n"
        "Keep the result compact and directly actionable."
    )
    prompt = raw_request
    if context:
        prompt = f"Recent conversation context (use only for resolving references):\n{context}\n\nCurrent request to refine:\n{raw_request}"
    content, usage = complete_once(
        url, key, model,
        [{"role": "system", "content": refiner_system},
         {"role": "user", "content": prompt}],
        backend,
        max_tokens=900,
    )
    return content.strip(), usage


def request_refinement(url, key, model, backend, inline_request, last_user_request, messages, totals):
    raw_request = inline_request.strip()
    if not raw_request:
        raw_request = last_user_request.strip()
    if not raw_request:
        raw_request = input("Request to refine: ").strip()
    if not raw_request:
        print("(refinement cancelled: no request supplied)")
        return ""
    refined, usage = refine_request(
        url, key, model, backend, raw_request, compact_refinement_context(messages)
    )
    in_tokens, out_tokens = usage_counts(usage)
    totals["in"] += in_tokens
    totals["out"] += out_tokens
    if not refined:
        print("(refinement returned no text; using the original request)")
        return raw_request
    print("\nRefined request:")
    print(refined)
    print_tokens("refiner", in_tokens, out_tokens)
    return refined


def normalize_pasted_command(lines):
    # A whole paste can arrive as a single input()-returned string containing
    # embedded bare-CR or CRLF line endings (no real \n for input() to split
    # on), so re-normalize line endings across the joined text before
    # re-splitting. Leading whitespace per line is preserved so indentation-
    # sensitive pastes (YAML, code, etc.) survive intact.
    combined = "\n".join(lines).replace("\r\n", "\n").replace("\r", "\n")
    raw = combined.split("\n")
    while raw and not raw[0].strip():
        raw.pop(0)
    while raw and not raw[-1].strip():
        raw.pop()
    if not raw:
        return ""
    if len(raw) == 1:
        return raw[0].strip()
    if raw[0].strip().startswith("/"):
        return raw[0].strip()
    return "\n".join(raw)


def read_user_command():
    try:
        first = input("\n> ")
    except (EOFError, KeyboardInterrupt):
        raise
    lines = [first]
    quiet_deadline = time.time() + 0.35
    while time.time() < quiet_deadline:
        remaining = max(0.0, quiet_deadline - time.time())
        ready, _, _ = select.select([sys.stdin], [], [], min(0.08, remaining))
        if not ready:
            continue
        extra = sys.stdin.readline()
        if extra == "":
            break
        lines.append(extra.rstrip("\n"))
        quiet_deadline = time.time() + 0.12
    user = normalize_pasted_command(lines).strip()
    if len(lines) > 1 and user:
        print("(normalized pasted multi-line input)")
    if user.lower() == "mlxcli":
        print("(you're already inside mlxcli — that won't be sent as a question. "
              "Use /exit to quit, or /help for commands.)")
        return ""
    return user


