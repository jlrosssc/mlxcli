        turn_mode = should_auto_enable_agentic(run_task) if requires_agentic_execution(run_task) else False
        max_verify_attempts = 3 if verify_command else 1
        for attempt in range(1, max_verify_attempts + 1):
            try:
                chat_turn(
                    url, key, model, messages, totals, turn_mode, backend,
                    execution_required=requires_agentic_execution(run_task),
                    contract=execution_contract(run_task),
