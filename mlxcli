def stop_omlx():
    if not OMLX_BIN.exists():
        return False
    result = subprocess.run([str(OMLX_BIN), "stop"], capture_output=True, text=True, timeout=30)
    output = (result.stdout or "") + (result.stderr or "")
    return result.returncode == 0 and ("stopped" in output.lower() or "stop" in output.lower() or not output.strip())


def stop_turbofieldfare(backend=None):
    pattern = "TurboFieldfareServer"
    if backend == "turbofieldfare":
        pattern = str(TURBO_MODEL_DIR)
    elif backend == "turbofieldfare-qwen":
        pattern = str(TURBO_QWEN_MODEL_DIR)
    first = subprocess.run(["pkill", "-f", pattern], capture_output=True, text=True, timeout=15)
    time.sleep(1)
    probe = subprocess.run(["pgrep", "-f", pattern], capture_output=True, text=True, timeout=15)
    if probe.returncode == 0:
        second = subprocess.run(["pkill", "-9", "-f", pattern], capture_output=True, text=True, timeout=15)
        return second.returncode == 0
    return first.returncode == 0


def stop_other_backend(target_backend):
    if target_backend == "omlx":
        stopped_gemma = stop_turbofieldfare("turbofieldfare")
        stopped_qwen = stop_turbofieldfare("turbofieldfare-qwen")
        if stopped_gemma or stopped_qwen:
            print("(stopped TurboFieldfare server)")
        else:
            print("(TurboFieldfare server was not running)")
    elif target_backend == "turbofieldfare":
        stopped = stop_omlx()
        print("(stopped oMLX)" if stopped else "(oMLX was not running)")
        stopped_qwen = stop_turbofieldfare("turbofieldfare-qwen")
        print("(stopped TurboFieldfare Qwen server)" if stopped_qwen else "(TurboFieldfare Qwen server was not running)")
    else:
        stopped = stop_omlx()
        print("(stopped oMLX)" if stopped else "(oMLX was not running)")
        stopped_gemma = stop_turbofieldfare("turbofieldfare")
        print("(stopped TurboFieldfare server)" if stopped_gemma else "(TurboFieldfare server was not running)")


def ensure_server(backend, url, key):
    if is_turbo_backend(backend):
        ensure_turbo_status_app()
    if server_up(url, key):
        return
    if is_turbo_backend(backend):
        paths = backend_paths(backend)
        if not paths["server_bin"].exists():
            sys.exit(f"{backend_label(backend)} server not found at {paths['server_bin']} — build it first.")
        if not paths["model_dir"].exists():
            sys.exit(f"{backend_label(backend)} model not found at {paths['model_dir']} — install the model first.")
        print(f"{backend_label(backend)} server not running — launching it...")
        paths["log"].parent.mkdir(parents=True, exist_ok=True)
        log_handle = open(paths["log"], "a")
        log_handle.write(f"\n=== launch {datetime.now().isoformat()} ===\n")
        log_handle.flush()
        launch_args = [str(paths["server_bin"]), "--model", str(paths["model_dir"]), "--port", paths["port"],
             "--max-context", str(SERVER_MAX_CONTEXT_TOKENS)]
        if backend == "turbofieldfare-qwen":
            # Benchmarked +1-11% decode speed (community benchmark protocol, all 3
            # cases, confirmed at --max-context 32768 with no instability) from
            # keeping more MoE experts resident instead of re-fetching from disk.
            launch_args += ["--expert-cache-slots", "32", "--rdadvise", "default"]
        subprocess.Popen(
            launch_args,
            cwd=paths["root"],
            stdout=log_handle,
            stderr=log_handle,
            start_new_session=True,
        )
    else:
        print("oMLX not running — launching it...")
        r = subprocess.run(["open", "-a", "oMLX"], capture_output=True, text=True)
        if r.returncode != 0:
            sys.exit("Couldn't find the oMLX app in /Applications — start it manually.")
        if OMLX_BIN.exists():
            print("Starting oMLX server...")
            subprocess.run([str(OMLX_BIN), "start", "--timeout", "60"], capture_output=True, text=True)
    waited = 0
    while waited < 60:
        time.sleep(2)
        waited += 2
        if server_up(url, key):
            print(f"{backend_label(backend)} is up.")
            return
    if is_turbo_backend(backend):
        sys.exit(f"{backend_label(backend)} server did not come up in 60s — check the build/model install.")
    sys.exit("oMLX launched but the server didn't come up in 60s — check the menu bar icon.")


def list_models(backend, url, key):
