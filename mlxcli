def parse_text_tool_calls(content):
    """Parse the narrow textual call syntax emitted by some Turbo adapters."""
    if not content or "call:" not in content:
        return []
    patterns = (
        ("run_command", r"call:(?:(?:[A-Za-z0-9_]+)[.:])*run_command\s*\{\s*command:\s*(\"(?:\\.|[^\"])*\")\s*\}"),
        ("python_interpreter", r"call:python_interpreter\s*\{\s*code:\s*(\"(?:\\.|[^\"])*\")\s*\}"),
        ("write_file", r"call:(?:(?:[A-Za-z0-9_]+)[.:])*write_file\s*\{\s*path:\s*(\"(?:\\.|[^\"])*\")\s*,\s*(?:content|text):\s*(\"(?:\\.|[^\"])*\")\s*\}"),
        ("read_file", r"call:(?:(?:[A-Za-z0-9_]+)[.:])*read_file\s*\{\s*path:\s*(\"(?:\\.|[^\"])*\")\s*\}"),
    )
    calls = []
    for name, pattern in patterns:
        for match in re.finditer(pattern, content, flags=re.DOTALL):
            try:
                value = json.loads(match.group(1))
            except json.JSONDecodeError:
                continue
            if name == "run_command":
                args = {"command": value}
            elif name == "python_interpreter":
                args = {"code": value}
            elif name == "read_file":
                args = {"path": value}
            else:
                second = re.search(r"(?:content|text):\s*(\"(?:\\.|[^\"])*\")", match.group(0), flags=re.DOTALL)
                if not second:
                    continue
                try:
                    args = {"path": value, "content": json.loads(second.group(1))}
                except json.JSONDecodeError:
                    continue
            calls.append({"id": _unique_call_id("text_call"), "type": "function",
                          "function": {"name": name, "arguments": json.dumps(args)}})
    if not any(call["function"]["name"] == "python_interpreter" for call in calls):
        marker = "call:python_interpreter{code:"
        start = content.find(marker)
        if start >= 0:
            payload = content[start + len(marker):].strip()
            if payload.startswith('"'):
                payload = payload[1:]
            # Turbo's text adapter closes this form with a quote and brace.
            end = payload.rfind("}")
            if end >= 0:
                payload = payload[:end].rstrip()
            if payload.endswith('"'):
                payload = payload[:-1]
            if payload:
                payload = payload.replace('\\n', '\n').replace('\\"', '"')
                calls.append({"id": _unique_call_id("text_call"), "type": "function",
                              "function": {"name": "python_interpreter",
                                            "arguments": json.dumps({"code": payload})}})
    return calls


