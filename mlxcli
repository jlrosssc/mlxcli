def request_messages_for_turn(messages):
    user_text = ""
    for message in reversed(messages):
        if message.get("role") == "user":
            user_text = message.get("content") or ""
            break
    if not is_code_request(user_text):
        return messages
    scoped = list(messages)
    insert_at = 1 if scoped and scoped[0].get("role") == "system" else 0
    scoped.insert(insert_at, {"role": "system", "content": CODE_REQUEST_SYSTEM})
    return scoped


def collapse_system_messages(messages):
    system_parts = []
    rest = []
    for message in messages:
        if message.get("role") == "system":
            content = (message.get("content") or "").strip()
            if content:
                system_parts.append(content)
        else:
            rest.append(message)
    if not system_parts:
        return rest
    merged = [{"role": "system", "content": "\n\n".join(system_parts)}]
    merged.extend(rest)
    return merged


def request_messages_for_mode(messages, agentic_mode, backend):
    scoped = list(request_messages_for_turn(messages))
    insert_at = 1 if scoped and scoped[0].get("role") == "system" else 0
    if agentic_mode:
        scoped.insert(insert_at, {"role": "system", "content": (
            "Agentic mode is enabled. When the user asks about local files, remote files, directories, repos, "
            "or shell-accessible information, prefer using available tools instead of only describing what they "
            "could run. Keep tool use minimal, explicit, and relevant. Favor acting over explaining when the task "
            "is concrete and tool-accessible. Never claim a file was created, run, inspected, verified, or shared "
            "unless a tool actually performed that action and returned evidence."
        )})
    else:
        scoped.insert(insert_at, {"role": "system", "content": (
            "Agentic mode is disabled. Do not attempt tool use; answer only from the provided conversation context."
        )})
    if is_turbo_backend(backend):
        scoped = collapse_system_messages(scoped)
    return scoped


