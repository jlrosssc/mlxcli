def request(url, key, path, payload=None):
    headers = {"Content-Type": "application/json"}
    if key:
        headers["Authorization"] = f"Bearer {key}"
    return urllib.request.Request(
        url + path,
        data=json.dumps(payload).encode() if payload is not None else None,
        headers=headers)


def api(url, key, path, payload=None):
    with urllib.request.urlopen(request(url, key, path, payload), timeout=900) as r:
        return json.load(r)


def server_up(url, key):
    try:
        api(url, key, "/v1/models")
        return True
    except Exception:
        return False


def ensure_server(backend, url, key):
    if server_up(url, key):
        return
    if backend == "turbofieldfare":
        if not TURBO_SERVER_BIN.exists():
            sys.exit(f"TurboFieldfare server not found at {TURBO_SERVER_BIN} — build TurboFieldfare first.")
        if not TURBO_MODEL_DIR.exists():
            sys.exit(f"TurboFieldfare model not found at {TURBO_MODEL_DIR} — install the model in the TurboFieldfare app first.")
        print("TurboFieldfare server not running — launching it...")
        TURBO_SERVER_LOG.parent.mkdir(parents=True, exist_ok=True)
        log_handle = open(TURBO_SERVER_LOG, "a")
        log_handle.write(f"\n=== launch {datetime.now().isoformat()} ===\n")
        log_handle.flush()
        subprocess.Popen(
            [str(TURBO_SERVER_BIN), "--model", str(TURBO_MODEL_DIR)],
            cwd=TURBO_ROOT,
            stdout=log_handle,
            stderr=log_handle,
        )
    else:
        print("oMLX not running — launching it...")
        r = subprocess.run(["open", "-a", "oMLX"], capture_output=True, text=True)
        if r.returncode != 0:
            sys.exit("Couldn't find the oMLX app in /Applications — start it manually.")
        if OMLX_BIN.exists():
            print("Starting oMLX server...")
            subprocess.run([str(OMLX_BIN), "start", "--timeout", "60"], capture_output=True, text=True)
    waited = 0
    while waited < 60:
        time.sleep(2)
        waited += 2
        if server_up(url, key):
            print(f"{'TurboFieldfare' if backend == 'turbofieldfare' else 'oMLX'} is up.")
            return
    if backend == "turbofieldfare":
        sys.exit("TurboFieldfare server did not come up in 60s — check the app/model install.")
    sys.exit("oMLX launched but the server didn't come up in 60s — check the menu bar icon.")


def list_models(backend, url, key):
    try:
        data = api(url, key, "/v1/models")
    except Exception as e:
        name = "TurboFieldfare" if backend == "turbofieldfare" else "oMLX"
        sys.exit(f"Cannot reach {name} at {url} ({e}). Is the server running?")
    ids = [m["id"] for m in data.get("data", [])]
    if not ids:
        name = "TurboFieldfare" if backend == "turbofieldfare" else "oMLX"
        sys.exit(f"{name} reports no models.")
    return ids


def model_tags(model_id):
    name = model_id.lower()
    tags = []
    if "coder" in name or "code" in name:
        tags.append("Coding")
    if "gpt-oss" in name or "reason" in name or "r1" in name:
        tags.append("Reasoning")
    if "vision" in name or "vl" in name or "llava" in name:
        tags.append("Vision")
    if "instruct" in name or "chat" in name or "qwen" in name or "llama" in name or "gemma" in name:
        tags.append("General")
    if "creative" in name or "story" in name or "write" in name:
        tags.append("Creative")
    if not tags:
        tags.append("General")
    return list(dict.fromkeys(tags))


def model_label(model_id):
    return f"{model_id} [{' / '.join(model_tags(model_id))}]"


def pick_model(backend, url, key):
    ids = list_models(backend, url, key)
    if len(ids) == 1:
        return ids[0]
    print("Available local models:")
    for i, mid in enumerate(ids, 1):
        print(f"  {i}) {model_label(mid)}")
    try:
        choice = input(f"Select model [1-{len(ids)}, Enter for 1]: ").strip()
    except KeyboardInterrupt:
        print("\n(cancelled)")
        raise EOFError
    try:
        return ids[int(choice) - 1] if choice else ids[0]
    except (ValueError, IndexError):
        print("(invalid selection — keeping first model)")
        return ids[0]


def pick_backend(current_backend):
    print("Available backends:")
    labels = list(SUPPORTED_BACKENDS)
    for i, name in enumerate(labels, 1):
        marker = " (current)" if name == current_backend else ""
        print(f"  {i}) {name}{marker}")
    try:
        choice = input(f"Select backend [1-{len(labels)}, Enter for {current_backend}]: ").strip().lower()
    except KeyboardInterrupt:
        print("\n(cancelled)")
        raise EOFError
    if not choice:
        return current_backend
    if choice in labels:
        return choice
    try:
        return labels[int(choice) - 1]
    except (ValueError, IndexError):
        print("(invalid selection — keeping current backend)")
        return current_backend


# ---------- tools ----------

def approve(desc):
    return input(f"  approve: {desc} [y/N] ").strip().lower() == "y"


def exec_tool(name, args):
    if name == "run_command":
        cmd = args.get("command", "")
        if not approve(f"run: {cmd}"):
            return "User declined."
        try:
            p = subprocess.run(cmd, shell=True, capture_output=True,
                               text=True, timeout=180)
            out = (p.stdout + p.stderr).strip()
            return out[:MAX_FILE_CHARS] if out else "(no output)"
        except subprocess.TimeoutExpired:
            return "Command timed out."
    if name == "read_file":
        try:
            text = pathlib.Path(args["path"]).expanduser().read_text()
            note = "" if len(text) <= MAX_FILE_CHARS else "\n[truncated]"
            print(f"  read: {args['path']} ({len(text)} chars)")
            return text[:MAX_FILE_CHARS] + note
        except Exception as e:
            return f"Error: {e}"
    if name == "write_file":
        path = args.get("path", "")
        content = args.get("content", "")
        target = resolve_output_path(path)
        old = ""
        if target.exists():
            try:
                old = target.read_text(errors="replace")
            except Exception:
                old = ""
        diff = list(difflib.unified_diff(
            old.splitlines(), content.splitlines(),
            fromfile=f"{path} (current)", tofile=f"{path} (proposed)",
            lineterm=""))
        if diff:
            print("  --- proposed change ---")
            for line in diff[:80]:
                print(f"  {line}")
            if len(diff) > 80:
                print(f"  ... ({len(diff) - 80} more diff lines)")
        else:
            print("  (no textual change)")
        if not approve(f"write {len(content)} chars to {target}"):
            return "User declined."
        try:
            target.parent.mkdir(parents=True, exist_ok=True)
            target.write_text(content)
            return "Written."
        except Exception as e:
            return f"Error: {e}"
    return "Unknown tool."


