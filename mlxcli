def parse_args(argv):
    model = None
    system = load_system_prompt()
    run_task = None
    auto_yes = False
    show_thinking = False
    i = 0
    while i < len(argv):
        if argv[i] in ("-p", "--prompt") and i + 1 < len(argv):
            system = argv[i + 1]
            i += 2
        elif argv[i] in ("-r", "--run") and i + 1 < len(argv):
            run_task = argv[i + 1]
            i += 2
        elif argv[i] in ("-y", "--yes"):
            auto_yes = True
            i += 1
        elif argv[i] == "--thinking":
            show_thinking = True
            i += 1
        elif argv[i] in ("-h", "--help"):
            print(__doc__)
            sys.exit(0)
        else:
            model = argv[i]
            i += 1
    return model, system, run_task, auto_yes, show_thinking


