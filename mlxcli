def do_save(arg, messages, model):
    raw = arg.strip().strip('"')
    if raw:
        out = resolve_output_path(raw)
    else:
        stamp = time.strftime("%Y%m%d-%H%M%S")
        out = load_default_dir() / f"mlxcli-{stamp}.md"
    lines = [f"# mlxcli session — {time.strftime('%Y-%m-%d %H:%M')} — model: {model}\n"]
    for m in messages:
        role = m.get("role")
        content = m.get("content") or ""
        if role == "system" or not content:
            continue
        title = {"user": "You", "assistant": "Model", "tool": "Tool output"}.get(role, role)
        lines.append(f"## {title}\n\n{content}\n")
    try:
        out.parent.mkdir(parents=True, exist_ok=True)
        out.write_text("\n".join(lines))
        print(f"(saved transcript to {out})")
    except Exception as e:
        print(f"(couldn't save: {e})")


def do_export(arg, messages):
    content = ""
    for message in reversed(messages):
        if message.get("role") == "assistant" and message.get("content"):
            content = message["content"]
            break
    if not content:
        print("(there is no model reply to export yet)")
        return
    raw = arg.strip().strip('"')
    if raw:
        out = resolve_output_path(raw)
    else:
        stamp = time.strftime("%Y%m%d-%H%M%S")
