def load_selected_files(messages, files, convert_mode, limit=8, char_budget=MAX_LOADED_CONTEXT_CHARS):
    labels = []
    seen = set()
    loaded_chars = 0
    stopped_for_budget = False
    for path in files:
        key = str(path)
        if key in seen:
            continue
        seen.add(key)
        try:
            text, label = convert_file(path, convert_mode)
        except RuntimeError as e:
            print(f"({path.name}: {e})")
            continue
        content, display_label, clipped_len = content_message_for_text(label, text)
        if labels and loaded_chars + clipped_len > char_budget:
            stopped_for_budget = True
            break
        messages.append({"role": "user", "content": content})
        labels.append(display_label)
        loaded_chars += clipped_len
        if len(labels) >= limit:
            break
    if stopped_for_budget:
        print(f"(stopped loading more files at ~{loaded_chars:,} chars to keep context manageable)")
    return labels


def resolve_file_token(token, allow_recursive_scan=True):
    """Resolve an explicit path; refuse ambiguous bare filenames instead of guessing."""
    p = pathlib.Path(token).expanduser()
    if p.is_absolute() or p.parent != pathlib.Path("."):
        options = [p] if p.is_absolute() else [pathlib.Path.cwd() / p, DOWNLOADS / p]
        for option in options:
            if option.exists() and option.is_file():
                return option
        return None
    matches = []
    for option in (pathlib.Path.cwd() / p, DOWNLOADS / p):
        if option.exists() and option.is_file() and option not in matches:
            matches.append(option)
    if not matches and allow_recursive_scan:
        try:
            for option in DOWNLOADS.rglob(p.name):
                if option.is_file() and option not in matches:
                    matches.append(option)
        except OSError:
            pass
    return matches[0] if len(matches) == 1 else None


def resolve_local_file_reference(text, allow_recursive_scan=True):
    quoted = re.findall(r'[`"\']([^`"\']+\.(?:txt|md|docx|pdf|doc|pptx|xlsx|yaml|yml|json|csv|tsv))[`"\']', text, re.I)
    bare = re.findall(r'(?<![A-Za-z0-9_./~-])([A-Za-z0-9_./~-]+\.(?:txt|md|docx|pdf|doc|pptx|xlsx|yaml|yml|json|csv|tsv))', text, re.I)
    candidates = quoted + bare
    checked = []
    for raw in candidates:
        token = raw.strip().strip('`').strip('"').strip("'").rstrip(".,:;")
        if not token:
            continue
        option = resolve_file_token(token, allow_recursive_scan=allow_recursive_scan)
        if option and str(option) not in checked:
            checked.append(str(option))
            return option
    lowered = (text or "").lower()
    if "downloads" in lowered and not (quoted or bare):
        for raw in bare:
            name = pathlib.Path(raw.strip().rstrip(".,:;")).name
            if not name:
                continue
            candidate = DOWNLOADS / name
            if candidate.exists() and candidate.is_file():
                return candidate
        for candidate in sorted(DOWNLOADS.rglob("*")):
            if (
                candidate.is_file()
                and len(candidate.name) >= 6
                and (
                    candidate.suffix.lower() in CONVERTIBLE
                    or candidate.suffix.lower() in REVIEWABLE_TEXT
                )
                and candidate.name.lower() in lowered
            ):
                return candidate
    return None


def resolve_local_file_references(text, limit=12, allow_recursive_scan=True):
    refs = []
    checked = set()
    quoted = re.findall(r'[`"\']([^`"\']+\.(?:txt|md|docx|pdf|doc|pptx|xlsx|yaml|yml|json|csv|tsv))[`"\']', text, re.I)
    bare = re.findall(r'(?<![A-Za-z0-9_./~-])([A-Za-z0-9_./~-]+\.(?:txt|md|docx|pdf|doc|pptx|xlsx|yaml|yml|json|csv|tsv))', text, re.I)
    lowered = (text or "").lower()
    for raw in quoted + bare:
        token = raw.strip().strip('`').strip('"').strip("'").rstrip(".,:;")
        if not token:
            continue
        option = resolve_file_token(token, allow_recursive_scan=allow_recursive_scan)
        if option and str(option) not in checked:
            checked.add(str(option))
            refs.append(option)
        if len(refs) >= limit:
            break
    # Do not scan all of Downloads when an explicit filename was supplied.
    # Generic names such as README.txt are not unique.
    if not refs and "downloads" in lowered and not (quoted or bare):
        for candidate in sorted(DOWNLOADS.rglob("*")):
            if (
                not candidate.is_file()
                or len(candidate.name) < 6
                or candidate.suffix.lower() not in CONVERTIBLE
                and candidate.suffix.lower() not in REVIEWABLE_TEXT
                or candidate.name.lower() not in lowered
            ):
                continue
            refs.append(candidate)
            if len(refs) >= limit:
                break
    return refs


def resolve_local_folder_reference(text):
    lowered = (text or "").lower()
    if "manager resumes" in lowered:
        candidate = DOWNLOADS / "Manager Resumes"
        if candidate.exists() and candidate.is_dir():
            return candidate
    match = re.search(r'in\s+downloads/([A-Za-z0-9 _-]+)', text or "", re.I)
    if match:
        candidate = DOWNLOADS / match.group(1).strip()
        if candidate.exists() and candidate.is_dir():
            return candidate
    return None


def detect_export_path(text):
    patterns = [
        r'(?:save|export)\s+(?:it\s+)?(?:to|as)\s+([~A-Za-z0-9_./ -]+\.(?:docx|md|txt|csv|xlsx))',
    ]
    for pattern in patterns:
        found = re.findall(pattern, text or "", re.I)
        for raw in found:
            token = raw.strip().strip('"').strip("'").rstrip(".,:;")
            if token:
                return token
    return None


def direct_top_files_request(user):
    """Handle the common Downloads size query without shell parsing or model tool loops."""
    lowered = (user or "").lower()
    if "downloads" not in lowered or "largest" not in lowered or "file" not in lowered:
        return None
    match = re.search(r"\btop\s+(\d+)\b", lowered)
    if not match:
        return None
    count = max(1, min(int(match.group(1)), 100))
    files = []
    try:
        for path in DOWNLOADS.iterdir():
            if path.is_file():
                try:
                    files.append((path.stat().st_size, path.name))
                except OSError:
                    continue
    except OSError:
        return None
    files.sort(key=lambda item: (-item[0], item[1].lower()))
    rows = files[:count]
    if not rows:
        return "No files found directly in Downloads."
    return "\n".join(f"{index}. `{name}` ({size:,} bytes)" for index, (size, name) in enumerate(rows, 1))


def maybe_handle_natural_language_action(user, state, messages, convert_mode, url, key, model, totals, backend, last_turn):
    lowered = (user or "").lower().strip()
    if not lowered:
        return False
    direct_result = direct_top_files_request(user)
    if direct_result:
        print(direct_result)
        messages.append({"role": "user", "content": user})
        messages.append({"role": "assistant", "content": direct_result})
        last_turn["in"] = 0
        last_turn["out"] = 0
        return True
    has_input_verb = any(re.search(rf'\b{re.escape(verb)}\b', lowered) for verb in INPUT_VERBS)
    has_output_verb = any(re.search(rf'\b{re.escape(verb)}\b', lowered) for verb in OUTPUT_VERBS)
    # A pure creation request ("create X with rows...") has no business auto-loading
    # some unrelated same-named leftover file from elsewhere in Downloads into context.
    local_files = resolve_local_file_references(user or "", allow_recursive_scan=has_input_verb)
    local_file = local_files[0] if local_files else None
    local_folder = resolve_local_folder_reference(user or "")
    resume_heavy_request = (
        ("downloads" in lowered or "download" in lowered)
        and "resume" in lowered
        and any(term in lowered for term in (
            "review", "compare", "rank", "most experience", "most experienced",
            "years of experience", "seniority", "strongest", "weakest", "list the one",
        ))
    )
    if resume_heavy_request:
        term = infer_filename_term(user) or "resume"
        print(f"(routing to /namefind ~/Downloads {term})")
        matches = do_namefind(f'"{DOWNLOADS}" "{term}"') or []
        state["last_paths"] = matches
        if not matches:
            return True
        content, turn_in, turn_out, elapsed = resume_compare_batched(
            url, key, model, backend, [pathlib.Path(p) for p in matches], convert_mode, user
        )
        if not content:
            return True
        print()
        print(content)
        messages.append({"role": "user", "content": user})
        messages.append({"role": "assistant", "content": content})
        totals["in"] += turn_in
        totals["out"] += turn_out
        last_turn["in"] = turn_in
        last_turn["out"] = turn_out
        print_tokens("turn", turn_in, turn_out, elapsed=elapsed)
        return True
    if (local_files or local_folder) and (has_input_verb or has_output_verb or "matrix" in lowered or "table" in lowered):
        loaded = []
        file_filter_text = user
        for previous in reversed(messages):
            if previous.get("role") != "user":
                continue
            previous_text = previous.get("content", "")
            if len(re.findall(r"\b\d{12}\b", previous_text)) >= 2:
                file_filter_text = previous_text + "\n" + user
                break
        if local_files:
            for path in local_files[:12]:
                print(f"(routing to /read {path})")
                do_read(str(path), messages, convert_mode, request_text=file_filter_text)
                loaded.append(path)
        elif local_folder:
            files = reviewable_paths(local_folder)
            if files:
                labels = load_selected_files(messages, files, convert_mode, limit=12)
                print(f"(loaded {len(labels)} file(s) from {local_folder})")
                loaded.extend(files[:len(labels)])
        state["last_paths"] = loaded
        state["context_loaded"] = bool(loaded)
        messages.append({"role": "user", "content": f"Using the loaded file above, {user.strip()}"})
        return "continue_model"
    if "find files" in lowered and "download" in lowered and any(term in lowered for term in ("title", "name", "contain", "resume")):
        term = infer_filename_term(user) or "resume"
        print(f"(routing to /namefind ~/Downloads {term})")
        matches = do_namefind(f'"{DOWNLOADS}" "{term}"')
        state["last_paths"] = matches or []
        return True
    remote_match = re.search(r'find all\s+(\.[A-Za-z0-9]+)\s+files?\s+at\s+([A-Za-z0-9._-]+@[A-Za-z0-9._-]+)', lowered)
    if remote_match:
        ext = remote_match.group(1)
        host = remote_match.group(2)
        pattern = rf'{re.escape(ext)}$'
        print(f"(routing to /sshfind {host}:/ {pattern})")
        do_sshfind(f"{host}:/ {shlex.quote(pattern)}")
        return True
    local_ls = re.search(r'list files in\s+(.+)$', user.strip(), re.IGNORECASE)
    if local_ls:
        target = local_ls.group(1).strip()
        print(f"(routing to /ls {target})")
        do_ls(target)
        return True
    return False


def git_root_for(path):
    here = pathlib.Path(path).expanduser()
    base = here if here.is_dir() else here.parent
    for candidate in [base, *base.parents]:
        if (candidate / ".git").exists():
            return candidate
    return None


def run_local_command(args, cwd=None):
    proc = subprocess.run(args, capture_output=True, text=True, cwd=cwd)
    output = (proc.stdout or "") + (proc.stderr or "")
    return proc.returncode, output.strip()


def parse_remote_spec(raw):
    spec = raw.strip().strip('"').strip("'")
    if ":" not in spec:
        raise ValueError("remote spec must look like user@host:/path")
    host, path = spec.split(":", 1)
    host = host.strip()
    path = path.strip() or "."
    if not host:
        raise ValueError("missing remote host before ':'")
    return host, path


def ssh_password_for(host):
    pw = SSH_PASSWORD_CACHE.get(host)
    if pw is not None:
        return pw
    pw = getpass.getpass(f"({host}) Password: ")
    SSH_PASSWORD_CACHE[host] = pw
    return pw


def ssh_base_command(host, password):
    env = os.environ.copy()
    env["SSHPASS"] = password
    cmd = [
        "/opt/homebrew/bin/sshpass",
        "-e",
        "ssh",
        "-o",
        "PreferredAuthentications=password,keyboard-interactive",
        "-o",
        "PubkeyAuthentication=no",
        "-o",
        "NumberOfPasswordPrompts=1",
        host,
    ]
    return cmd, env


def run_ssh_command(host, command):
    password = ssh_password_for(host)
    base_cmd, env = ssh_base_command(host, password)
    proc = subprocess.run(base_cmd + [command], capture_output=True, text=True, timeout=180, env=env)
    output = (proc.stdout or "") + (proc.stderr or "")
    return proc.returncode, output.strip()


def run_ssh_command_with_input(host, command, input_text):
    password = ssh_password_for(host)
    base_cmd, env = ssh_base_command(host, password)
    proc = subprocess.run(
        base_cmd + [command],
        input=input_text,
        capture_output=True,
        text=True,
        timeout=180,
        env=env,
    )
    output = (proc.stdout or "") + (proc.stderr or "")
    return proc.returncode, output.strip()


def do_gitstatus(arg):
    raw = arg.strip().strip('"').strip("'")
    target = pathlib.Path(raw).expanduser() if raw else pathlib.Path.cwd()
    root = git_root_for(target)
    if not root:
        print(f"(not inside a git repo: {target})")
        return
    code, output = run_local_command(["git", "status", "--short"], cwd=root)
    if code != 0:
        print(f"(git status failed)\n{output}")
        return
    print(f"{root}:")
    print(output or "(clean)")


def do_gitdiff(arg):
    raw = arg.strip().strip('"').strip("'")
    target = pathlib.Path(raw).expanduser() if raw else pathlib.Path.cwd()
    root = git_root_for(target)
    if not root:
        print(f"(not inside a git repo: {target})")
        return
    rel = None
    if raw:
        try:
            rel = str(target.relative_to(root))
        except ValueError:
            rel = None
    cmd = ["git", "diff", "--stat"]
    if rel and rel != ".":
        cmd.extend(["--", rel])
    code, output = run_local_command(cmd, cwd=root)
    if code != 0:
        print(f"(git diff failed)\n{output}")
        return
    print(f"{root}:")
    print(output or "(no diff)")


def do_sshls(arg):
    raw = arg.strip()
    if not raw:
        print("usage: /sshls USER@HOST:PATH")
        return
    try:
        host, path = parse_remote_spec(raw)
    except ValueError as e:
        print(f"({e})")
        return
    if not approve(f"ssh ls {host}:{path}", category="ssh_read"):
        print("(declined)")
        return
    code, output = run_ssh_command(host, f"ls -la {shlex.quote(path)}")
    if code != 0:
        print(f"(ssh ls failed)\n{output}")
        return
    print(output or "(no output)")


def do_sshread(arg, messages):
