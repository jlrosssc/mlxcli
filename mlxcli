def _append_system_content(messages, text):
    """Fold `text` into the existing leading system message rather than
    inserting a new system-role entry. Both backends' chat templates reject
    any system message that isn't at index 0 (`system message must be
    first`), so inserting a second or third one — as this used to do —
    produces a valid-looking messages list that fails server-side the moment
    the turn is sent. One combined system message at index 0 is always safe."""
    if messages and messages[0].get("role") == "system":
        messages[0]["content"] = messages[0]["content"] + "\n\n" + text
    else:
        messages.insert(0, {"role": "system", "content": text})


def remote_rag_context(messages, user_text, limit=4, collection_override=None, no_match_warning=True):
    """Returns (status, results). status is None if RAG isn't configured (not
    applicable to this turn), False if it was searched but found nothing,
    True if excerpts were injected. Callers use this to distinguish "not
    grounded because RAG is off" from "searched and came up empty" — the
    latter is the case where a model can confidently fabricate a
    citation-shaped answer with nothing behind it. Unless
    no_match_warning=False (used when the caller is about to skip the turn
    entirely, e.g. strict mode), an explicit instruction not to fabricate is
    inserted into messages on a no-match result. results is the raw list of
    retrieved excerpts (empty list if none) — callers can store this the
    same way /rag search results are stored, so a plain chat turn's
    retrieval is just as inspectable (numbered, full-text-on-demand) as an
    explicit search."""
    url, key, configured_collection = rag_remote_config()
    # None = defer to RAG_COLLECTION env var (unchanged default behavior);
    # "" = explicitly search all collections; anything else = that collection,
    # set for the rest of this session via /rag collection NAME.
    collection = configured_collection if collection_override is None else collection_override
    if not url:
        return None, []
    # A leading "from COLLECTION, ..." phrase names its target explicitly and
    # wins over any session default — fuzzy-matched against the real,
    # current collection list so a typo ("founding documenets") still
    # resolves, and the matched phrase is stripped from the search text
    # along with common instruction filler ("list all references to").
    search_text = user_text
    natural_collection = detect_natural_language_collection(user_text, url, key)
    if natural_collection:
        collection, search_text = natural_collection
        print(f"(interpreting as: collection={collection!r} query={search_text!r})")
    # If the message embeds a recognizable Bible reference (e.g. "show me
    # commentary on John 3:16"), search for just that reference under all its
    # known forms instead of the whole sentence — filler words like "show me
    # commentary on" don't appear in source text and would otherwise dilute
    # or zero out the match.
    reference_variants = find_embedded_bible_reference(search_text)
    seen_keys = set()
    results = []
    for query in (reference_variants or [search_text]):
        data = rag_remote_search(query, url, key, collection, limit=limit)
        for result in data.get("results") or []:
            dedupe_key = (result.get("id"), result.get("chunk_index"))
            if dedupe_key not in seen_keys:
                seen_keys.add(dedupe_key)
                results.append(result)
    results.sort(key=lambda r: r.get("score", 0), reverse=True)
    results = results[:limit]
    # The RAG server's score isn't a normalized similarity — it's small and
    # corpus/query-length dependent (an exact, distinctive quote can score
    # ~0.017, but a short genuinely on-topic query can score ~0.005, so no
    # fixed cutoff cleanly separates signal from noise for every query).
    # RAG_MIN_SCORE only exists to catch the clear case: a query with no
    # topical connection to any collection still gets low but nonzero
    # keyword-overlap scores (~0.001-0.007 observed) on whatever happens to
    # share a few common words, and those get presented as "relevant source
    # excerpts" with nothing to indicate they're noise. Filtering below this
    # floor trades a few borderline real matches for not treating noise as
    # a citation-worthy source.
    min_score = float(os.environ.get("RAG_MIN_SCORE", "0.01"))
    results = [r for r in results if r.get("score", 0) >= min_score]
    if not results:
        print(f"(remote RAG: no matches in {collection or 'all collections'})")
        if no_match_warning:
            _append_system_content(messages, (
                f"A RAG search of {collection or 'all configured collections'} for this message "
                "found no matching source excerpts. If the user's request depends on retrieved "
                "source material (an exact quotation, a specific document's content, or commentary "
                "attributed to a specific named source), say plainly that no matching source was "
                "found rather than answering from memory or presenting an unsourced guess as if it "
                "were the retrieved content. You may still answer questions that don't depend on "
                "retrieval normally."
            ))
        return False, []
    lines = [
        f"Remote RAG server: {url}",
        f"Remote RAG collection: {collection or '(all collections)'}",
        "Relevant source excerpts:",
    ]
    labels = []
    for result in results:
        label = f"{result.get('title') or result.get('filename')} chunk {result.get('chunk_index', 0)}"
        labels.append(label)
        lines.append(f"\n[{label}]\n{result.get('content', '')}")
    _append_system_content(messages, RAG_REMOTE_SYSTEM + "\n" + "\n".join(lines))
    numbered = "; ".join(f"[{i}] {label}" for i, label in enumerate(labels, start=1))
    print(f"(remote RAG: used {len(results)} excerpt(s) — {numbered})")
    print(f"(type a number 1-{len(results)} to see that excerpt's full, untruncated text — "
          "the model only saw what's shown here, so this is what to check if an answer looks off)")
    return True, results


def do_rag_fetch(arg):
    """/rag fetch ID [FILENAME] — save one document's full, unchunked content
    to a local file, regardless of collection or document type. Search only
    ever returns small matching snippets; this is the generic way to get the
    complete text so any of mlxcli's normal tools (/find, /read, agentic
    reading) can work on it directly — useful whenever a search snippet
    isn't enough context (an exact section of a manual, a full chapter of a
    book, a specific clause of a founding document, a bible chapter, etc.)."""
    parts = arg.strip().split(None, 1)
    if not parts:
        print("usage: /rag fetch ID [FILENAME]  (ID from /rag list or /rag search results)")
        return None
    document_id = parts[0]
    url, key, _ = rag_remote_config()
    if not url or not key:
        print("Remote RAG is not configured. Set RAG_URL and RAG_API_KEY.")
        return None
    try:
        data = rag_remote_get_document(document_id, url, key)
    except Exception as exc:
        print(f"[remote RAG error] {exc}")
        return None
    content = data.get("content", "")
    title = data.get("title") or data.get("filename") or document_id
    if len(parts) > 1:
        filename = parts[1]
    else:
        safe = re.sub(r"[^A-Za-z0-9 _.-]", "", title).strip().replace(" ", "_")[:80] or document_id
        filename = f"{safe}.txt"
    dest = load_default_dir() / filename
    dest.write_text(content)
    print(f"(saved \"{title}\" — {len(content):,} chars — to {dest})")
    print("Use /read, /find, or reference this path directly to work with the full text.")
    return None


def do_rag_esv(arg):
    """/rag esv REFERENCE — exact ESV passage text via api.esv.org, fetched
    live each call. Never cached or stored (ESV isn't in the local RAG
    corpus and never will be — this stays a per-request API call, per
    Crossway's personal/non-commercial API terms)."""
    reference = arg.strip()
    if not reference:
        print("usage: /rag esv REFERENCE  (e.g. /rag esv Romans 1:18-32)")
        return
    try:
        _canonical, text = esv_passage(reference)
    except Exception as exc:
        print(f"[ESV API error] {exc}")
        return
    print(f"\n{text}")


def do_rag(arg):
    url, key, configured_collection = rag_remote_config()
    if not url or not key:
        print("Remote RAG is not configured. Set RAG_URL and RAG_API_KEY (optionally RAG_COLLECTION).")
        return
    parts = shlex.split(arg.strip()) if arg.strip() else ["status"]
    command = parts[0].lower()
    collection = configured_collection
    if command == "list" and len(parts) > 1:
        collection = parts[1]
    if command == "upload" and len(parts) > 2:
        collection = parts[2]
    try:
        if command == "status":
            print(rag_remote_request("GET", f"{url}/health", key))
        elif command == "collections":
            data = rag_remote_collections(url, key)
            for row in data.get("collections", []):
                marker = " (active)" if row.get("collection") == configured_collection else ""
                print(f"{row.get('collection')}  {row.get('documents')} document(s){marker}")
        elif command == "list":
            data = rag_remote_list(url, key, collection)
            for doc in data.get("documents", []):
                print(f"{doc.get('id')}  {doc.get('title') or doc.get('filename')}  {doc.get('metadata', {})}")
            print(f"({len(data.get('documents', []))} document(s))")
        elif command == "search":
            query_parts = parts[1:]
            explicit_collection = False
            if len(query_parts) >= 2 and query_parts[0] == "--collection":
                collection, query_parts = query_parts[1], query_parts[2:]
                explicit_collection = True
            query = " ".join(query_parts)

            # Compound query ("topic A or topic B or topic C"): only when no
            # explicit --collection was given, since that already pins a
            # single scope the user chose on purpose. Each clause gets
            # searched against every existing collection and only kept where
            # it actually returns something — no hardcoded topic-to-collection
            # mapping, so this works for whatever collections exist, not just
            # the ones that happen to be populated right now.
            clauses = re.split(r"\s+\bor\b\s+", query, flags=re.IGNORECASE) if not explicit_collection else [query]
            results = []
            if len(clauses) > 1:
                all_collections = [c.get("collection") for c in rag_remote_collections(url, key).get("collections", [])]
                seen_keys = set()
                for clause in clauses:
                    clause_hits = []
                    for variant in expand_bible_reference_query(clause):
                        for coll in all_collections:
                            data = rag_remote_search(variant, url, key, coll, limit=3)
                            for result in data.get("results", []):
                                dedupe_key = (result.get("id"), result.get("chunk_index"))
                                if dedupe_key not in seen_keys:
                                    seen_keys.add(dedupe_key)
                                    result["_topic"] = clause
                                    result["_collection"] = coll
                                    clause_hits.append(result)
                    clause_hits.sort(key=lambda r: r.get("score", 0), reverse=True)
                    print(f"(topic {clause!r}: {len(clause_hits)} match(es)"
                          + (f", best in {clause_hits[0]['_collection']}" if clause_hits else "") + ")")
                    results.extend(clause_hits)
            else:
                variants = expand_bible_reference_query(query)
                seen_keys = set()
                for variant in variants:
                    data = rag_remote_search(variant, url, key, collection)
                    for result in data.get("results", []):
                        dedupe_key = (result.get("id"), result.get("chunk_index"))
                        if dedupe_key not in seen_keys:
                            seen_keys.add(dedupe_key)
                            results.append(result)
                results.sort(key=lambda r: r.get("score", 0), reverse=True)
                if len(variants) > 1:
                    print(f"(expanded book-name search: tried {', '.join(repr(v) for v in variants)})")

            for index, result in enumerate(results, start=1):
                topic_tag = f" [topic: {result['_topic']!r} in {result['_collection']}]" if "_topic" in result else ""
                print(f"\n[{index}] {result.get('title')} chunk {result.get('chunk_index')} score={result.get('score')}{topic_tag}\n{result.get('content', '')[:1200]}")
            if results:
                print(f"\n(type a number 1-{len(results)} to see that result's full, untruncated text)")
            return results
        elif command == "upload" and len(parts) >= 2:
            path = pathlib.Path(parts[1]).expanduser()
            data = rag_remote_upload(path, url, key, collection)
            print(f"uploaded {data.get('id')} ({data.get('chunks')} chunks)")
        elif command == "update" and len(parts) >= 3:
            path = pathlib.Path(parts[2]).expanduser()
            data = rag_remote_update(parts[1], path.read_text(errors="replace"), url, key, collection, filename=path.name)
            print(f"updated {data.get('id')} ({data.get('chunks')} chunks)")
        elif command == "delete" and len(parts) >= 2:
            print(rag_remote_delete(parts[1], url, key))
        else:
            print("usage: /rag status | collections | list [collection] | search [collection] QUERY | upload PATH [collection] | update ID PATH | delete ID")
    except (OSError, urllib.error.HTTPError, urllib.error.URLError, ValueError) as exc:
        print(f"[remote RAG error] {exc}")


def do_gitstatus(arg):
    raw = arg.strip().strip('"').strip("'")
    target = pathlib.Path(raw).expanduser() if raw else pathlib.Path.cwd()
    root = git_root_for(target)
    if not root:
        print(f"(not inside a git repo: {target})")
        return
    code, output = run_local_command(["git", "status", "--short"], cwd=root)
    if code != 0:
        print(f"(git status failed)\n{output}")
        return
    print(f"{root}:")
    print(output or "(clean)")


def do_gitdiff(arg):
    raw = arg.strip().strip('"').strip("'")
    target = pathlib.Path(raw).expanduser() if raw else pathlib.Path.cwd()
    root = git_root_for(target)
    if not root:
        print(f"(not inside a git repo: {target})")
        return
    rel = None
    if raw:
        try:
            rel = str(target.relative_to(root))
        except ValueError:
            rel = None
    cmd = ["git", "diff", "--stat"]
    if rel and rel != ".":
        cmd.extend(["--", rel])
    code, output = run_local_command(cmd, cwd=root)
    if code != 0:
        print(f"(git diff failed)\n{output}")
        return
    print(f"{root}:")
    print(output or "(no diff)")


