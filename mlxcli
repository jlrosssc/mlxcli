                labels = load_selected_files(messages, selected_paths, convert_mode, limit=12)
                if labels:
                    messages.append({"role": "user", "content": prompt_for_loaded_files(user, labels)})
                    print(f"(agentic loaded {len(labels)} file(s) from the last search results)")
                    handled_followup = True
        if not handled_followup:
            rag_status, rag_results = remote_rag_context(
                messages, user, collection_override=rag_collection_override,
                no_match_warning=not rag_strict_mode)
            if rag_results:
                state["last_rag_results"] = rag_results
            if rag_strict_mode and rag_status is False:
                print("(strict RAG mode: no source material found — not generating a response)")
                continue
            messages.append({"role": "user", "content": user})
            if agentic_mode:
                for note in apply_agentic_preflight(user, messages, convert_mode):
                    print(note)
        messages = trim(messages)
        try:
            turn_in, turn_out = chat_turn(
                url, key, model, messages, totals, request_agentic_mode, backend,
                execution_required=requires_agentic_execution(user),
                contract=execution_contract(user),
            )
            last_turn = {"in": turn_in, "out": turn_out}
            if pending_export_path:
                auto_export_latest(messages, pending_export_path)
        except urllib.error.HTTPError as e:
            body = e.read().decode(errors="replace")[:400]
            log_error("chat_turn", f"HTTP {e.code} (backend={backend}, model={model}): {body}")
            print(f"\n[server error {e.code}] {body}")
        except KeyboardInterrupt:
            print("\n(interrupted; returning to mlxcli prompt)")
            continue
        except Exception as e:
            log_error("chat_turn", f"{type(e).__name__} (backend={backend}, model={model}): {e}")
            print(f"\n[error] {e}")


if __name__ == "__main__":
    main()
