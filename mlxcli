    stop_other_backend(backend)
    ensure_server(backend, url, key)
    available_models = list_models(backend, url, key)
    if model_arg and model_arg not in available_models:
        # The positional arg is a *model* id, not a backend name — passing a
        # backend name here (an easy mistake, since /backend takes one) used to
        # silently send a request for a nonexistent model and surface as a
        # confusing 404 mid-generation instead of a clear error up front.
        print(f"(model '{model_arg}' not found on backend '{backend}'; available: {', '.join(available_models) or 'none'})")
        if run_task:
            sys.exit(1)
        model_arg = None
    model = model_arg or (available_models[0] if run_task else pick_model(backend, url, key))
    messages = [{"role": "system", "content": system}]
