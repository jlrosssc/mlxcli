def stream_once(url, key, model, messages, agentic_mode, backend):
    """One streamed request. Returns (content, tool_calls, usage)."""
    payload = {"model": model, "messages": request_messages_for_mode(messages, agentic_mode, backend),
               "max_tokens": MAX_RESPONSE_TOKENS, "stream": True,
               "stream_options": {"include_usage": True}}
    if agentic_mode:
        payload["tools"] = TOOLS
    content_parts = []
    calls = {}
    usage = {}
    printed = False
    with urllib.request.urlopen(request(url, key, "/v1/chat/completions",
                                        payload), timeout=900) as r:
        for rawline in r:
            line = rawline.decode("utf-8", errors="replace").strip()
            if not line.startswith("data:"):
                continue
            data = line[5:].strip()
            if data == "[DONE]":
                break
            try:
                chunk = json.loads(data)
            except json.JSONDecodeError:
                continue
            if chunk.get("usage"):
                usage = chunk["usage"]
            choices = chunk.get("choices") or []
            if not choices:
                continue
            delta = choices[0].get("delta") or {}
            piece = delta.get("content")
            if piece:
                if not printed:
                    print()
                    printed = True
                print(piece, end="", flush=True)
                content_parts.append(piece)
            for tc in delta.get("tool_calls") or []:
                idx = tc.get("index", 0)
                slot = calls.setdefault(idx, {"id": tc.get("id"),
                                              "name": "", "arguments": ""})
                if tc.get("id"):
                    slot["id"] = tc["id"]
                fn = tc.get("function") or {}
                if fn.get("name"):
                    slot["name"] += fn["name"]
                if fn.get("arguments"):
                    slot["arguments"] += fn["arguments"]
    if printed:
        print()
    tool_calls = [{"id": c["id"] or f"call_{i}", "type": "function",
                   "function": {"name": c["name"], "arguments": c["arguments"]}}
                  for i, c in sorted(calls.items())]
    return "".join(content_parts), tool_calls, usage


def chat_turn(url, key, model, messages, totals, agentic_mode, backend):
    turn_in = 0
    turn_out = 0
    for _ in range(MAX_TOOL_STEPS):
        content, tool_calls, usage = stream_once(url, key, model, messages, agentic_mode, backend)
        in_tokens, out_tokens = usage_counts(usage)
        turn_in += in_tokens
        turn_out += out_tokens
        if not tool_calls and not content and in_tokens == 0 and out_tokens == 0:
            print("(turn failed: server returned no output and no token usage; reduce loaded context or retry)")
            return 0, 0
        if not tool_calls:
            messages.append({"role": "assistant", "content": content})
            totals["in"] += turn_in
            totals["out"] += turn_out
            print_tokens("turn", turn_in, turn_out)
            return turn_in, turn_out
        messages.append({"role": "assistant", "content": content or None,
                         "tool_calls": tool_calls})
        for call in tool_calls:
            fn = call["function"]["name"]
            try:
                args = json.loads(call["function"].get("arguments") or "{}")
            except json.JSONDecodeError:
                args = {}
            result = exec_tool(fn, args)
            messages.append({"role": "tool", "tool_call_id": call["id"],
                             "content": result})
    print("(stopped: too many tool steps — break the task into smaller pieces)")
    totals["in"] += turn_in
    totals["out"] += turn_out
    print_tokens("turn", turn_in, turn_out)
    return turn_in, turn_out


def trim(messages):
    starts = [i for i, m in enumerate(messages) if m.get("role") == "user"]
    if len(starts) > MAX_HISTORY_TURNS:
        cut = starts[-MAX_HISTORY_TURNS]
        return [messages[0]] + messages[cut:]
    return messages


def commands_only_from_help():
    commands = []
    for line in HELP.splitlines():
        stripped = line.strip()
        if stripped.startswith("/"):
            commands.append(stripped.split()[0])
    return "  " + "  ".join(commands)


def verbs_text():
    return (
        "input verbs:  " + ", ".join(INPUT_VERBS) + "\n" +
        "output verbs: " + ", ".join(OUTPUT_VERBS)
    )


def normalize_pasted_command(lines):
    cleaned = [line.strip() for line in lines if line.strip()]
    if not cleaned:
        return ""
    if len(cleaned) == 1:
        return cleaned[0]
    if cleaned[0].startswith("/"):
        return cleaned[0]
    return " ".join(cleaned)


def read_user_command():
    try:
        first = input("\n> ")
    except (EOFError, KeyboardInterrupt):
        raise
    lines = [first]
    quiet_deadline = time.time() + 0.35
    while time.time() < quiet_deadline:
        remaining = max(0.0, quiet_deadline - time.time())
        ready, _, _ = select.select([sys.stdin], [], [], min(0.08, remaining))
        if not ready:
            continue
        extra = sys.stdin.readline()
        if extra == "":
            break
        lines.append(extra.rstrip("\n"))
        quiet_deadline = time.time() + 0.12
    user = normalize_pasted_command(lines).strip()
    if len(lines) > 1 and user:
        print("(normalized pasted multi-line input)")
    return user


def do_where(backend, url, model, convert_mode, agentic_mode, state):
    remote = state.get("current_remote") or "(none)"
    remote_dir = state.get("current_remote_dir") or "(none)"
    last_remote_path = state.get("last_remote_path") or "(none)"
    print(f"backend: {backend}")
    print(f"url: {url}")
    print(f"model: {model}")
    print(f"convert: {convert_mode}")
    print(f"agentic: {'on' if agentic_mode else 'off'}")
    print(f"remote: {remote}")
    print(f"remote dir: {remote_dir}")
    print(f"last remote path: {last_remote_path}")


def do_tflog():
    if not TURBO_SERVER_LOG.exists():
        print(f"(no TurboFieldfare log found at {TURBO_SERVER_LOG})")
        return
    try:
        lines = TURBO_SERVER_LOG.read_text(errors="replace").splitlines()
    except Exception as e:
        print(f"(could not read TurboFieldfare log: {e})")
        return
    tail = lines[-80:]
    print(str(TURBO_SERVER_LOG) + ":")
    for line in tail:
        print(line)


# ---------- main ----------

def parse_args(argv):
    model = None
    system = load_system_prompt()
    i = 0
    while i < len(argv):
        if argv[i] in ("-p", "--prompt") and i + 1 < len(argv):
            system = argv[i + 1]
            i += 2
        elif argv[i] in ("-h", "--help"):
            print(__doc__)
            sys.exit(0)
        else:
            model = argv[i]
            i += 1
    return model, system


def main():
    backend, url, key = load_cfg()
    model_arg, system = parse_args(sys.argv[1:])
    if not model_arg:
        selected_backend = pick_backend(backend)
        if selected_backend != backend:
            save_backend(selected_backend)
            backend, url, key = load_cfg()
    ensure_server(backend, url, key)
    model = model_arg or pick_model(backend, url, key)
    print(f"mlxcli — backend: {backend} — model: {model} — /help for commands")
    messages = [{"role": "system", "content": system}]
    totals = {"in": 0, "out": 0}
    last_turn = {"in": 0, "out": 0}
    convert_mode = "auto"
    agentic_mode = False
    state = {"last_paths": [], "current_remote": None, "current_remote_dir": None, "last_remote_path": None}
    while True:
        try:
            user = read_user_command().strip()
        except (EOFError, KeyboardInterrupt):
            print()
            break
        if not user:
            continue
        if user in ("/exit", "/quit"):
            break
        if user == "/commands":
            print(commands_only_from_help())
            continue
        if user == "/verbs":
            print(verbs_text())
            continue
        if user == "/help":
            print(HELP)
            continue
        if user == "/backend":
            print(f"(backend: {backend})")
            continue
        if user.startswith("/backend "):
            selected = user.split(None, 1)[1].strip().lower()
            if selected not in SUPPORTED_BACKENDS:
                print("usage: /backend omlx|turbofieldfare")
                continue
            try:
                save_backend(selected)
            except Exception as e:
                print(f"[error] could not save backend: {e}")
                continue
            backend, url, key = load_cfg()
            ensure_server(backend, url, key)
            model = model_arg or pick_model(backend, url, key)
            print(f"(backend: {backend}; model: {model})")
            continue
        if user == "/clear":
            messages = [{"role": "system", "content": system}]
            state["last_paths"] = []
            state["current_remote"] = None
            state["current_remote_dir"] = None
            state["last_remote_path"] = None
            print("(history cleared)")
            continue
        if user == "/system":
            print(system)
            continue
        if user.startswith("/system save "):
            content = user[len("/system save "):].strip()
            if not content:
                print("usage: /system save TEXT")
                continue
            try:
                save_system_prompt(content)
            except Exception as e:
                print(f"[error] could not save system prompt: {e}")
                continue
            system = content
            messages[0] = {"role": "system", "content": system}
            print(f"(saved dialogue defaults to {SYSTEM_PROMPT_PATH})")
            continue
        if user.startswith("/system preset "):
            preset = user[len("/system preset "):].strip().lower()
            if preset not in PRESET_SYSTEMS:
                print("usage: /system preset concise|code|docs|default")
                continue
            system = PRESET_SYSTEMS[preset]
            try:
                save_system_prompt(system)
            except Exception as e:
                print(f"[error] could not save system prompt: {e}")
                continue
            messages[0] = {"role": "system", "content": system}
            print(f"(saved {preset} dialogue preset)")
            continue
        if user == "/system default":
            try:
                save_system_prompt(DEFAULT_SYSTEM)
            except Exception as e:
                print(f"[error] could not restore system prompt: {e}")
                continue
            system = DEFAULT_SYSTEM
            messages[0] = {"role": "system", "content": system}
            print("(restored built-in dialogue defaults)")
            continue
        if user == "/tokens":
            print_tokens("session", totals["in"], totals["out"])
            continue
        if user == "/agentic":
            print(f"(agentic mode: {'on' if agentic_mode else 'off'})")
            continue
        if user.startswith("/agentic "):
            mode = user.split(None, 1)[1].strip().lower()
            if mode not in {"on", "off"}:
                print("usage: /agentic on|off")
                continue
            agentic_mode = mode == "on"
            print(f"(agentic mode: {'on' if agentic_mode else 'off'})")
            continue
        if user in ("/resources", "/resource"):
            do_resources(totals, messages, last_turn)
            continue
        if user == "/convert":
            print(f"(paste conversion: {convert_mode}; modes: auto, all, off)")
            continue
        if user.startswith("/convert "):
            mode = user.split(None, 1)[1].strip().lower()
            if mode not in CONVERT_MODES:
                print("usage: /convert auto|all|off")
                continue
            convert_mode = mode
            print(f"(paste conversion: {convert_mode})")
            continue
        if user == "/mem":
            do_mem()
            continue
        if user == "/tflog":
            do_tflog()
            continue
        if user == "/where":
            do_where(backend, url, model, convert_mode, agentic_mode, state)
            continue
        if user == "/models":
            for mid in list_models(backend, url, key):
                print(f"  {mid}" + (" (active)" if mid == model else ""))
            continue
        if user == "/model":
            model = pick_model(backend, url, key)
            print(f"(switched to {model} — history kept)")
            continue
        if user.startswith("/save"):
            do_save(user[5:], messages, model)
            continue
        if user.startswith("/export"):
            do_export(user[7:], messages)
            continue
        if user.startswith("/paste"):
            do_paste(user[6:], messages, convert_mode)
            continue
        if user.startswith("/review"):
            if do_review(user[7:], messages, convert_mode):
                messages = trim(messages)
                try:
                    turn_in, turn_out = chat_turn(url, key, model, messages, totals, agentic_mode, backend)
                    last_turn = {"in": turn_in, "out": turn_out}
                except urllib.error.HTTPError as e:
                    body = e.read().decode(errors="replace")[:400]
                    print(f"\n[server error {e.code}] {body}")
                except Exception as e:
                    print(f"\n[error] {e}")
            continue
        if user.startswith("/resumecompare"):
            if do_resumecompare(user[len("/resumecompare"):], messages, convert_mode):
                messages = trim(messages)
                try:
                    turn_in, turn_out = chat_turn(url, key, model, messages, totals, agentic_mode, backend)
                    last_turn = {"in": turn_in, "out": turn_out}
                except urllib.error.HTTPError as e:
                    body = e.read().decode(errors="replace")[:400]
                    print(f"\n[server error {e.code}] {body}")
                except Exception as e:
                    print(f"\n[error] {e}")
            continue
        if user.startswith("/yamlaudit"):
            if do_yamlaudit(user[len("/yamlaudit"):], messages, convert_mode):
                messages = trim(messages)
                try:
                    turn_in, turn_out = chat_turn(url, key, model, messages, totals, agentic_mode, backend)
                    last_turn = {"in": turn_in, "out": turn_out}
                except urllib.error.HTTPError as e:
                    body = e.read().decode(errors="replace")[:400]
                    print(f"\n[server error {e.code}] {body}")
                except Exception as e:
                    print(f"\n[error] {e}")
            continue
        if user.startswith("/read"):
            do_read(user[5:], messages, convert_mode)
            continue
        if user.startswith("/find"):
            do_find(user[5:])
            continue
        if user.startswith("/namefind"):
            state["last_paths"] = do_namefind(user[9:]) or []
            continue
        if user == "/ls" or user.startswith("/ls "):
            do_ls(user[3:])
            continue
        if user == "/gitstatus" or user.startswith("/gitstatus "):
            do_gitstatus(user[10:])
            continue
        if user == "/gitdiff" or user.startswith("/gitdiff "):
            do_gitdiff(user[8:])
            continue
        if user.startswith("/sshls"):
            do_sshls(user[6:])
            continue
        if user.startswith("/sshread"):
            do_sshread(user[8:], messages)
            continue
        if user.startswith("/sshfind"):
            do_sshfind(user[8:])
            continue
        if user.startswith("/sshwrite"):
            do_sshwrite(user[9:])
            continue
        if user.startswith("/sshrun"):
            do_sshrun(user[7:])
            continue
        if maybe_handle_remote_natural_language_action(user, state):
            continue
        nl_result = maybe_handle_natural_language_action(user, state, messages, convert_mode)
        if nl_result is True:
            continue
        if nl_result == "continue_model":
            messages = trim(messages)
            try:
                turn_in, turn_out = chat_turn(url, key, model, messages, totals, agentic_mode, backend)
                last_turn = {"in": turn_in, "out": turn_out}
            except urllib.error.HTTPError as e:
                body = e.read().decode(errors="replace")[:400]
                print(f"\n[server error {e.code}] {body}")
            except Exception as e:
                print(f"\n[error] {e}")
            continue
        handled_followup = False
        if should_follow_last_results(user) and state["last_paths"]:
            selected_paths = state["last_paths"]
            if "resume" in user.lower():
                selected_paths = [p for p in selected_paths if "resume" in pathlib.Path(p).name.lower()]
            labels = load_selected_files(messages, selected_paths, convert_mode, limit=12)
            if labels:
                messages.append({"role": "user", "content": prompt_for_loaded_files(user, labels)})
                print(f"(agentic loaded {len(labels)} file(s) from the last search results)")
                handled_followup = True
        if not handled_followup:
            messages.append({"role": "user", "content": user})
            if agentic_mode:
                for note in apply_agentic_preflight(user, messages, convert_mode):
                    print(note)
        messages = trim(messages)
        try:
            turn_in, turn_out = chat_turn(url, key, model, messages, totals, agentic_mode, backend)
            last_turn = {"in": turn_in, "out": turn_out}
        except urllib.error.HTTPError as e:
            body = e.read().decode(errors="replace")[:400]
            print(f"\n[server error {e.code}] {body}")
        except Exception as e:
            print(f"\n[error] {e}")


if __name__ == "__main__":
