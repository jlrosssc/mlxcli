    clipped = text[:MAX_FILE_CHARS]
    note = "" if len(text) <= MAX_FILE_CHARS else " [truncated to 8000 chars]"
    messages.append({"role": "user",
                     "content": f"Contents of {label}:\n\n{clipped}"})
    print(f"(pasted {label}: {len(clipped)} chars into context{note} — now ask about it)")


