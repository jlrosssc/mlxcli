def configure_readline():
    """Enable predictable arrow-key editing and persistent CLI command history."""
    if readline is None or not sys.stdin.isatty():
        return
    try:
        readline.parse_and_bind("set editing-mode emacs")
        readline.parse_and_bind("set enable-bracketed-paste on")
        readline.parse_and_bind('"\\e[A": previous-history')
        readline.parse_and_bind('"\\e[B": next-history')
        readline.parse_and_bind('"\\e[C": forward-char')
        readline.parse_and_bind('"\\e[D": backward-char')
        readline.set_history_length(300)
        readline.read_history_file(str(READLINE_HISTORY_PATH))
    except (OSError, AttributeError, RuntimeError):
        pass

    def save_history():
        try:
            READLINE_HISTORY_PATH.parent.mkdir(parents=True, exist_ok=True)
            readline.write_history_file(str(READLINE_HISTORY_PATH))
        except (OSError, AttributeError, RuntimeError):
            pass

    atexit.register(save_history)


