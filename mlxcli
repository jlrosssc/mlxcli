def parse_args(argv):
    model = None
    system = load_system_prompt()
    run_task = None
    # Auto-approve (and therefore sandbox — see main()) is now the default;
    # --ask opts back into the old prompted/unsandboxed behavior. -y/--yes is
    # kept accepted as a no-op so old scripts and muscle memory don't break.
    auto_yes = True
    show_thinking = False
    verify_command = None
    verify_history_dir = None
    i = 0
    while i < len(argv):
        if argv[i] in ("-p", "--prompt") and i + 1 < len(argv):
            system = argv[i + 1]
            i += 2
        elif argv[i] in ("-r", "--run") and i + 1 < len(argv):
            run_task = argv[i + 1]
            i += 2
        elif argv[i] in ("-y", "--yes"):
            auto_yes = True
            i += 1
        elif argv[i] == "--ask":
            auto_yes = False
            i += 1
        elif argv[i] == "--thinking":
            show_thinking = True
            i += 1
        elif argv[i] == "--verify" and i + 1 < len(argv):
            verify_command = argv[i + 1]
            i += 2
        elif argv[i] == "--verify-history" and i + 1 < len(argv):
            verify_history_dir = argv[i + 1]
            i += 2
        elif argv[i] in ("-h", "--help"):
            print(__doc__)
            sys.exit(0)
        else:
            model = argv[i]
            i += 1
    return model, system, run_task, auto_yes, show_thinking, verify_command, verify_history_dir


def print_repo_update_notice_if_any(root, label):
    """Synchronous check for pending updates on a git repo's remotes (e.g.
    TURBO_QWEN_ROOT), printed before the interactive prompt starts. Was
    previously a background thread, but its print() could land after the
    readline prompt was already active and waiting for input — the notice
    text would interleave with the prompt mid-display, leaving the terminal
    looking stuck until the user pressed Enter to force a redraw. Running
    this before anything interactive is shown (bounded by
    compute_repo_update_status's own 10s timeout, and it never raises)
    trades a small one-time startup delay for never hitting that race.
    Silent when there's nothing to report, so it never adds noise to a
    normal launch."""
    info = compute_repo_update_status(root)
    if not info:
        return
    lines = [f"\n(⬆ {label} ({info['branch']}) has updates available:"]
    for remote_ref, count in info["remotes"].items():
        lines.append(f"  {remote_ref}: {count} new commit{'s' if count != 1 else ''}")
    lines.append(
        "This only checks and fetches — nothing is pulled or rebuilt "
        "automatically. Merge on a separate branch, build, and test on "
        "an alternate port before touching the running server.)"
    )
    print("\n".join(lines))


def main():
    configure_readline()
