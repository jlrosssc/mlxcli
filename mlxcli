def do_model_settings(backend, arg):
    arg = arg.strip()
    settings = load_model_settings(backend)
    if not arg:
        print(f"Model settings — {backend_label(backend)}:")
        for key in MODEL_SETTING_DEFAULTS:
            lo, hi = MODEL_SETTING_BOUNDS[key]
            marker = "" if settings[key] == MODEL_SETTING_DEFAULTS[key] else "  (overridden)"
            print(f"  {key:<20} {settings[key]}{marker}   [{lo}..{hi}]")
        print("usage: /modelsettings set <key> <value>   /modelsettings reset")
        return
    if arg == "reset":
        save_model_settings(backend, dict(MODEL_SETTING_DEFAULTS))
        print(f"(reset model settings for {backend_label(backend)} to defaults)")
        return
    parts = arg.split(None, 2)
    if len(parts) == 3 and parts[0] == "set":
        key, raw_value = parts[1], parts[2]
        if key not in MODEL_SETTING_DEFAULTS:
            print(f"unknown setting: {key} (expected one of {', '.join(MODEL_SETTING_DEFAULTS)})")
            return
        try:
            value = int(raw_value) if key in ("top_k", "max_tokens") else float(raw_value)
        except ValueError:
            print(f"invalid value for {key}: {raw_value}")
