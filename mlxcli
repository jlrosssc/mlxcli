def auto_export_latest(messages, raw_path):
    content = latest_assistant_content(messages)
    if not content:
        print("(there is no model reply to export yet)")
        return
    out = resolve_output_path(raw_path.strip().strip('"'))
    suffix = out.suffix.lower()
    tables = parse_markdown_table(content)
    try:
        out.parent.mkdir(parents=True, exist_ok=True)
        if suffix == ".csv":
            if not tables:
                print("(no markdown table found in latest reply for csv export)")
                return
            write_csv_from_table(out, tables[0][0], tables[0][1])
        elif suffix == ".xlsx":
            if not tables:
                print("(no markdown table found in latest reply for xlsx export)")
                return
            write_xlsx_from_table(out, tables[0][0], tables[0][1])
        elif suffix == ".docx":
            markdown_to_docx(out, "mlxcli Export", content)
        elif suffix == ".md":
            out.write_text(content)
        elif suffix == ".txt":
            out.write_text(markdown_to_text(content))
        else:
            out.write_text(content)
        print(f"(auto-exported latest reply to {out})")
    except Exception as e:
        print(f"(couldn't auto-export: {e})")


